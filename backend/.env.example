WMS_APP_NAME=Furniture WMS API
WMS_ENVIRONMENT=development
WMS_DEBUG=true
# ODBC Driver 18 phải được cài trên máy chạy API.
WMS_DATABASE_URL=mssql+aioodbc://@(localdb)\MSSQLLocalDB/FurnitureWMS?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
WMS_JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
WMS_JWT_ALGORITHM=HS256
WMS_ACCESS_TOKEN_EXPIRE_MINUTES=60
WMS_LOCK_TIMEOUT_SECONDS=8
