                  }
              }
              else if (ViewBag.AllOutbound != null)
              {
                  foreach (var it in (IEnumerable<dynamic>)ViewBag.AllOutbound)
                  {
                      <tr>
                          <td>@it.MovementId</td>
                          <td>@it.SkuId</td>
                          <td>@it.QuantityDelta</td>
                          <td>@it.PerformedBy</td>
                          <td>@((DateTime)it.CreatedAt).ToLocalTime().ToString("g")</td>
                          <td>@(it.Reference ?? "")</td>
                      </tr>
                  }
              }
              else
              {
                  <tr>
                      <td colspan="6" class="text-center text-muted">Không có dữ liệu xuất kho</td>
                  </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Optional: client-side filter inside modal
function wireModalSearch(inputId, tableId){
  const input = document.getElementById(inputId);
  const table = document.getElementById(tableId);
  if(!input || !table) return;
  input.addEventListener('input', function(){
    const q = this.value.toLowerCase();
    table.querySelectorAll('tbody tr').forEach(r=>{
      const txt = r.innerText.toLowerCase();
      r.style.display = txt.indexOf(q) !== -1 ? '' : 'none';
    });
  });
}
document.addEventListener('DOMContentLoaded', function(){
  wireModalSearch('invSearch','tableAllInventory');
  wireModalSearch('inSearch','tableAllInbound');
  wireModalSearch('outSearch','tableAllOutbound');
});
</script>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">-- Trạng thái / Loại --</option>
                <option value="GOOD" selected="@(Model?.Status == "GOOD" ? "selected" : null)">GOOD</option>
                <option value="DAMAGED" selected="@(Model?.Status == "DAMAGED" ? "selected" : null)">DAMAGED</option>
                <option value="RESERVED" selected="@(Model?.Status == "RESERVED" ? "selected" : null)">RESERVED</option>
            </select>
        </div>
            <div class="col-md-5 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <a href="@Url.Action("Index","Home")" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </form>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>📦 Tồn kho</strong>
                    <a class="btn btn-sm btn-link" href="#" data-bs-toggle="modal" data-bs-target="#modalAllInventory">Xem tất cả (50)</a>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <thead>
                            <tr><th>SKU</th><th>Sản phẩm</th><th>Kho</th><th>Trạng thái</th><th>Số lượng</th></tr>
                        </thead>
                        <tbody>
                            @foreach(var it in Model.Inventory)
                            {
                                <tr>
                                    <td>@it.SkuId</td>
                                    <td>@it.ProductName</td>
                                    <td>@it.WarehouseId</td>
                                    <td>@it.Status</td>
                                    <td>@it.Quantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer">
                    @if (!Model.ViewAll)
                    {
                        var totalPages = (int)Math.Ceiling(Model.InventoryTotal / (double)Model.PageSize);
                        <nav>
                            <ul class="pagination mb-0">
                                <li class="page-item @(Model.Page<=1?"disabled":"")"><a class="page-link" href="@Url.Action("Index","Home", new { page = Model.Page-1, tab = "inventory", search = Model.Search, status = Model.Status })">«</a></li>
                                @for (int i=1;i<=totalPages;i++){
                                    <li class="page-item @(i==Model.Page?"active":"")"><a class="page-link" href="@Url.Action("Index","Home", new { page = i, tab = "inventory", search = Model.Search, status = Model.Status })">@i</a></li>
                                }
                                <li class="page-item @(Model.Page>=totalPages?"disabled":"")"><a class="page-link" href="@Url.Action("Index","Home", new { page = Model.Page+1, tab = "inventory", search = Model.Search, status = Model.Status })">»</a></li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>📥 Lịch sử Nhập kho</strong>
                    <a class="btn btn-sm btn-link" href="#" data-bs-toggle="modal" data-bs-target="#modalAllInbound">Xem tất cả (50)</a>
