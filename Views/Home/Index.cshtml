        <div class="table-responsive">
          <table class="table table-sm table-striped" id="tableAllOutbound">
            <thead><tr><th>ID</th><th>SKU</th><th>Số lượng</th><th>Người thực hiện</th><th>Thời gian</th><th>Tham chiếu</th></tr></thead>
            <tbody id="outboundModalBody">
