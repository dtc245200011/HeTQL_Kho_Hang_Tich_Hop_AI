                  }
              }
              else if (ViewBag.AllOutbound != null)
              {
                  foreach (var it in (IEnumerable<dynamic>)ViewBag.AllOutbound)
                  {
                      <tr>
                          <td>@it.MovementId</td>
                          <td>@it.SkuId</td>
                          <td>@it.QuantityDelta</td>
                          <td>@it.PerformedBy</td>
                          <td>@((DateTime)it.CreatedAt).ToLocalTime().ToString("g")</td>
                          <td>@(it.Reference ?? "")</td>
                      </tr>
                  }
              }
              else
              {
                  <tr>
                      <td colspan="6" class="text-center text-muted">Không có dữ liệu xuất kho</td>
                  </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Optional: client-side filter inside modal
function wireModalSearch(inputId, tableId){
  const input = document.getElementById(inputId);
  const table = document.getElementById(tableId);
  if(!input || !table) return;
  input.addEventListener('input', function(){
    const q = this.value.toLowerCase();
    table.querySelectorAll('tbody tr').forEach(r=>{
      const txt = r.innerText.toLowerCase();
      r.style.display = txt.indexOf(q) !== -1 ? '' : 'none';
    });
  });
}
document.addEventListener('DOMContentLoaded', function(){
  wireModalSearch('invSearch','tableAllInventory');
  wireModalSearch('inSearch','tableAllInbound');
  wireModalSearch('outSearch','tableAllOutbound');
});
</script>


