@{
    Layout = null;
    var companyName = (Context.Items["CompanyName"] as string) ?? "DuAnCode WMS";
    var phone = Context.Items["CompanyPhone"] as string;
    var email = Context.Items["CompanyEmail"] as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hệ thống đang bảo trì - @companyName</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #f8fafc;
            margin: 0;
            padding: 1.5rem;
        }
        .maintenance-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 3rem 2.5rem;
            max-width: 600px;
            width: 100%;
            text-align: center;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .icon-wrapper {
            width: 90px;
            height: 90px;
            margin: 0 auto 1.75rem;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(239, 68, 68, 0.2), rgba(245, 158, 11, 0.2));
            border: 1px solid rgba(245, 158, 11, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: #f59e0b;
            box-shadow: 0 0 30px rgba(245, 158, 11, 0.2);
        }
        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(239, 68, 68, 0.15);
            color: #fca5a5;
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 0.35rem 0.85rem;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1.25rem;
        }
        .btn-admin {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            border: none;
            color: #fff;
            padding: 0.75rem 1.75rem;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }
        .btn-admin:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(59, 130, 246, 0.45);
            color: #fff;
        }
        .contact-box {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 1rem;
            margin-top: 2rem;
            font-size: 0.875rem;
            color: #94a3b8;
        }
    </style>
</head>
<body>
    <div class="maintenance-card">
        <div class="icon-wrapper">
            <i class="fa-solid fa-wrench"></i>
        </div>

        <div class="badge-status">
            <span class="spinner-grow spinner-grow-sm text-danger" role="status"></span>
            Hệ thống đang bảo trì
        </div>

        <h2 class="fw-bold mb-3">@companyName</h2>
        
        <p class="text-secondary leading-relaxed mb-4">
            Quản trị viên đã kích hoạt <strong>Chế độ Bảo trì Hệ thống</strong> để nâng cấp và bảo dưỡng cơ sở dữ liệu. 
            Quyền truy cập của nhân viên hiện đang được tạm dừng. Vui lòng quay lại sau!
        </p>

        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/Account/Login" class="btn btn-admin">
                <i class="fa-solid fa-shield-halved"></i> Đăng nhập Quản trị viên
            </a>
            <button onclick="window.location.reload()" class="btn btn-outline-light px-4" style="border-radius: 10px;">
                <i class="fa-solid fa-rotate-right me-1"></i> Kiểm tra lại
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(email) || !string.IsNullOrWhiteSpace(phone))
        {
            <div class="contact-box text-start">
                <div class="fw-semibold text-white mb-1"><i class="fa-solid fa-headset me-2 text-primary"></i>Liên hệ hỗ trợ kỹ thuật:</div>
                @if (!string.IsNullOrWhiteSpace(email))
                {
                    <div>Email: <a href="mailto:@email" class="text-primary text-decoration-none">@email</a></div>
                }
                @if (!string.IsNullOrWhiteSpace(phone))
                {
                    <div>Hotline: <span class="text-white">@phone</span></div>
                }
            </div>
        }
    </div>
</body>
</html>
