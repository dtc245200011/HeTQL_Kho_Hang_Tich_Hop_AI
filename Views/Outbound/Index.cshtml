@model DuAnCode.Web.Models.ViewModels.VoucherPageViewModel
@{
    ViewData["Title"] = "Phiếu Xuất kho (PX-01)";
    var skus = Model?.Skus ?? new List<DuAnCode.Web.Models.ViewModels.SkuDto>();
    var warehouses = Model?.Warehouses ?? new List<DuAnCode.Web.Models.Warehouse>();
    var recent = Model?.Recent ?? new List<DuAnCode.Web.Models.InventoryVoucher>();
}

<div class="container mt-4 invoice-root">
    <div class="card">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="fw-bold">CÔNG TY NỘI THẤT VFS</div>
                    <div class="small text-muted">Mẫu số: PX-01</div>
                </div>
                <div class="text-end">
                    <div>Số phiếu: <span id="voucherNumber">AUTO</span></div>
                    <div>Ngày: @DateTime.UtcNow.ToString("dd/MM/yyyy")</div>
                </div>
            </div>

            <h5 class="text-center mb-3">PHIẾU XUẤT KHO</h5>

            <form method="post" asp-action="Create" asp-controller="Outbound">
                @Html.AntiForgeryToken()
                <input type="hidden" name="VoucherId" value="@Model?.Form?.VoucherId" />
                <input type="hidden" name="VoucherNumber" value="AUTO" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row mb-2">
                    <div class="col-md-4">
                        <label>Nơi nhận hàng</label>
                        <input name="Counterparty" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label>Địa chỉ</label>
                        <input name="Address" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label>Kho</label>
                        <select name="WarehouseId" class="form-select">
                            @foreach(var w in warehouses) { <option value="@w.WarehouseId">@w.WarehouseName</option> }
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-8">
                        <label>Lý do</label>
                        <input name="Reason" class="form-control" />
                    </div>
                    <div class="col-md-4 text-end align-self-end">
                        <button type="button" class="btn btn-secondary me-2 no-print" onclick="window.print()">In phiếu</button>
                        <button type="submit" class="btn btn-primary no-print">Lưu phiếu</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered" id="linesTable">
                        <thead>
                            <tr><th style="width:40px">STT</th><th>Mã hàng</th><th>Tên hàng</th><th>ĐVT</th><th style="width:100px">Số lượng</th><th style="width:120px">Đơn giá</th><th style="width:120px">Thành tiền</th><th style="width:80px">&nbsp;</th></tr>
                        </thead>
                        <tbody>
                        @if(Model?.Form?.Lines != null && Model.Form.Lines.Any()){
                            for(int i=0;i<Model.Form.Lines.Count;i++){
                                var ln = Model.Form.Lines[i];
                                <tr>
                                    <td class="text-center">@(i+1)</td>
                                    <td>
                                        <select name="Lines[@i].SkuId" class="form-select sku-select">
                                            <option value="">-- Chọn SKU --</option>
                                            @foreach(var s in skus){ <option value="@s.SkuId" selected="@(s.SkuId==ln.SkuId)">@s.SkuId</option> }
                                        </select>
                                    </td>
                                    <td><input name="Lines[@i].ProductName" class="form-control product-name" value="@ln.ProductName" /></td>
                                    <td><input name="Lines[@i].Unit" class="form-control unit" value="@ln.Unit" /></td>
                                    <td><input name="Lines[@i].Quantity" type="number" min="0" value="@ln.Quantity" class="form-control qty" /></td>
                                    <td><input name="Lines[@i].UnitPrice" type="number" step="0.01" value="@ln.UnitPrice" class="form-control price" /></td>
                                    <td class="line-total">@(ln.UnitPrice * ln.Quantity)</td>
                                    <td class="text-center"><button type="button" class="btn btn-sm btn-danger remove-line">-</button></td>
                                    <input type="hidden" name="Lines[@i].Id" value="@ln.Id" />
                                </tr>
                            }
                        }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="6" class="text-end fw-bold">Tổng cộng</td>
                                <td class="fw-bold" id="totalAmount">0</td>
                                <td>&nbsp;</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mb-3">
                    <button type="button" class="btn btn-outline-primary no-print" id="addLine">+ Thêm hàng hóa</button>
                </div>
            </form>

            <!-- Recent history removed to avoid duplication with Dashboard -->
        </div>
    </div>
</div>

<script>
    const skus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(skus));

    function createRow(idx) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="text-center">${idx}</td>
            <td>
                <select name="Lines[${idx-1}].SkuId" class="form-select sku-select">
                    <option value="">-- Chọn SKU --</option>
                    ${skus.map(s=>`<option value="${s.SkuId}">${s.SkuId}</option>`).join('')}
                </select>
            </td>
            <td><input name="Lines[${idx-1}].ProductName" class="form-control product-name" /></td>
            <td><input name="Lines[${idx-1}].Unit" class="form-control unit" value="Cái" /></td>
            <td><input name="Lines[${idx-1}].Quantity" type="number" min="0" value="1" class="form-control qty" /></td>
            <td><input name="Lines[${idx-1}].UnitPrice" type="number" step="0.01" value="0" class="form-control price" /></td>
            <td class="line-total">0</td>
            <td class="text-center"><button type="button" class="btn btn-sm btn-danger remove-line">-</button></td>
        `;
        return tr;
    }

    function recalc() {
        const rows = document.querySelectorAll('#linesTable tbody tr');
        let total = 0;
        rows.forEach((r,i)=>{
            const qty = parseFloat(r.querySelector('.qty').value) || 0;
            const price = parseFloat(r.querySelector('.price').value) || 0;
            const lt = qty * price;
            r.querySelector('.line-total').innerText = lt.toLocaleString();
            total += lt;
        });
        document.getElementById('totalAmount').innerText = total.toLocaleString();
    }

    document.getElementById('addLine').addEventListener('click', ()=>{
        const tbody = document.querySelector('#linesTable tbody');
        const idx = tbody.children.length + 1;
        const row = createRow(idx);
        tbody.appendChild(row);
        row.querySelector('.sku-select').addEventListener('change', function(){
            const s = skus.find(x => x.SkuId === this.value);
            if (s) {
                const r = this.closest('tr');
                r.querySelector('.product-name').value = s.ProductName || '';
                r.querySelector('.unit').value = s.Unit || 'Cái';
            }
        });
        row.querySelector('.qty').addEventListener('input', recalc);
        row.querySelector('.price').addEventListener('input', recalc);
        row.querySelector('.remove-line').addEventListener('click', function(){ this.closest('tr').remove(); recalc(); });
    });

    // add one row by default
    document.getElementById('addLine').click();
</script>

<style>
    @@media print {
        .sidebar, .no-print, .btn { display:none !important; }
        .invoice-root { margin:0; }
    }
</style>
