@model IEnumerable<DuAnCode.Web.Models.InventoryVoucher>
@{
    ViewData["Title"] = "Quản lý Phiếu Xuất kho";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1">Quản lý Phiếu Xuất kho</h3>
            <span class="text-muted small">Tổng số: <strong id="totalVoucherCount">@Model.Count()</strong> phiếu xuất kho</span>
        </div>
        <a asp-action="Create" class="btn btn-primary" data-tooltip="Tạo Phiếu xuất kho mới"><i class="fa-solid fa-plus me-1"></i> Tạo Phiếu Mới</a>
    </div>

    <!-- Search & Filter Bar -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body py-3">
            <form method="get" asp-action="Index" id="voucherFilterForm" class="row g-2 align-items-center">
                <div class="col-12 col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" id="voucherSearchInput" class="form-control border-start-0 ps-0" placeholder="Tìm theo mã phiếu, người tạo, mã đơn hàng SO..." value="@ViewBag.Search" autocomplete="off" />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <select name="status" id="voucherStatusFilter" class="form-select">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="APPROVED" selected="@(ViewBag.Status == "APPROVED")">Đã duyệt</option>
                        <option value="PENDING" selected="@(ViewBag.Status == "PENDING")">Chờ duyệt</option>
                        <option value="DRAFT" selected="@(ViewBag.Status == "DRAFT")">Nháp</option>
                        <option value="REJECTED" selected="@(ViewBag.Status == "REJECTED")">Từ chối</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <input type="date" name="fromDate" id="voucherFromDate" class="form-control" title="Từ ngày" value="@ViewBag.FromDate" />
                </div>
                <div class="col-6 col-md-2">
                    <input type="date" name="toDate" id="voucherToDate" class="form-control" title="Đến ngày" value="@ViewBag.ToDate" />
                </div>
                <div class="col-12 col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" data-tooltip="Lọc dữ liệu từ máy chủ"><i class="fa-solid fa-filter"></i> Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary" data-tooltip="Xóa bộ lọc"><i class="fa-solid fa-rotate-left"></i></a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0" id="voucherTable">
                    <thead>
                        <tr>
                            <th data-tooltip="Mã định danh duy nhất của chứng từ xuất kho">Mã Phiếu</th>
                            <th data-tooltip="Thời gian lập chứng từ xuất kho">Ngày</th>
                            <th data-tooltip="Kho hàng thực hiện xuất">Kho xuất</th>
                            <th data-tooltip="Đối tác, đại lý hoặc khách hàng nhận hàng">Nơi nhận / Khách hàng</th>
                            <th data-tooltip="Trạng thái phê duyệt của phiếu: Nháp, Chờ duyệt, Đã duyệt, Từ chối">Trạng thái</th>
                            <th data-tooltip="Người khởi tạo chứng từ trong hệ thống">Người tạo</th>
                            <th data-tooltip="Tổng giá trị tiền hàng xuất kho">Tổng tiền</th>
                            <th style="width: 140px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="voucherTableBody">
                        @if (!Model.Any())
                        {
                            <tr id="serverEmptyRow">
                                <td colspan="8" class="p-0 border-0">
                                    <div class="wms-empty-state">
                                        <div class="wms-empty-icon-wrap">
                                            <i class="fa-solid fa-truck-ramp-box"></i>
                                        </div>
                                        <div class="wms-empty-title">Chưa có phiếu xuất kho nào</div>
                                        <div class="wms-empty-desc">
                                            Bắt đầu tạo lệnh xuất kho giao hàng cho khách hàng hoặc đại lý với cơ chế kiểm tra tồn kho tự động.
                                        </div>
                                        <a asp-action="Create" class="btn btn-primary px-4 shadow-sm">
                                            <i class="fa-solid fa-plus me-1"></i> Tạo Phiếu Xuất Đầu Tiên
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @foreach (var v in Model)
                        {
                            var warehouseMap = ViewBag.WarehouseMap as Dictionary<string, string> ?? new();
                            var whName = warehouseMap.GetValueOrDefault(v.WarehouseId ?? "", v.WarehouseId ?? "Chưa chọn");

                            <tr class="voucher-row" data-status="@v.Status" data-number="@v.VoucherNumber" data-creator="@v.CreatedBy" data-receiver="@v.Counterparty" data-wh="@whName">
                                <td><strong>@v.VoucherNumber</strong></td>
                                <td>@v.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <span class="badge bg-light text-dark border"><i class="fa-solid fa-warehouse me-1 text-primary"></i>@whName</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@(string.IsNullOrWhiteSpace(v.Counterparty) ? "-" : v.Counterparty)</span>
                                </td>
                                <td>
                                    @if (v.Status == "APPROVED")
                                    {
                                        <span class="badge bg-success" data-tooltip="Chứng từ đã duyệt - Hàng hóa đã được trừ tồn kho theo FIFO">Đã duyệt</span>
                                    }
                                    else if (v.Status == "REJECTED")
                                    {
                                        <button type="button" class="badge bg-danger border-0 p-2 shadow-sm text-white" style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#rejectionDetailModal_@v.VoucherId" data-tooltip="Bấm để xem lý do từ chối duyệt">
                                            <i class="fa-solid fa-circle-exclamation me-1"></i>Từ chối
                                        </button>
                                    }
                                    else if (v.Status == "PENDING")
                                    {
                                        <span class="badge bg-warning text-dark" data-tooltip="Chứng từ đang chờ quản lý kho kiểm tra và phê duyệt">Chờ duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" data-tooltip="Chứng từ bản nháp đang soạn thảo, chưa khóa sổ">Nháp</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    @{
                                        var isAi = v.VoucherNumber?.Contains("-AI-") == true || v.CreatedBy?.Contains("AI") == true || v.Reason?.Contains("AI") == true;
                                    }
                                    @if (isAi)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle fw-medium py-1 px-2" data-tooltip="Khởi tạo tự động bởi Trợ lý AI WMS">
                                            <i class="fa-solid fa-robot me-1"></i>@(v.CreatedBy ?? "Trợ lý AI")
                                        </span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(v.CreatedBy))
                                    {
                                        <span><i class="fa-solid fa-user me-1 text-secondary opacity-75 small"></i>@v.CreatedBy</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Chưa xác định</span>
                                    }
                                </td>
                                <td>@v.TotalAmount.ToString("C0")</td>
                                <td>
                                    <a asp-action="Create" asp-route-id="@v.VoucherId" class="btn btn-sm btn-info text-white btn-icon-only" data-tooltip="@(v.Status == "APPROVED" || v.Status == "REJECTED" ? "Xem chi tiết phiếu xuất" : "Xem chi tiết & Sửa phiếu xuất")"><i class="fa-solid fa-eye"></i></a>
                                    @if (v.Status == "REJECTED")
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-1 btn-icon-only" data-bs-toggle="modal" data-bs-target="#rejectionDetailModal_@v.VoucherId" data-tooltip="Xem chi tiết lý do từ chối duyệt">
                                            <i class="fa-solid fa-comment-slash"></i>
                                        </button>
                                    }
                                    @if (v.Status == "DRAFT" || v.Status == "PENDING")
                                    {
                                        <form asp-action="Approve" asp-route-id="@v.VoucherId" method="post" class="d-inline ms-1" onsubmit="return confirm('Bạn có chắc muốn duyệt phiếu này? Sau khi duyệt sẽ trừ Tồn kho và không thể sửa đổi.');">
                                            <button type="submit" class="btn btn-sm btn-success btn-icon-only" data-tooltip="Phê duyệt phiếu xuất (Tự động trừ tồn kho theo FIFO)"><i class="fa-solid fa-check"></i></button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-1 btn-icon-only" data-bs-toggle="modal" data-bs-target="#rejectModal_@v.VoucherId" data-tooltip="Từ chối duyệt phiếu xuất kho">
                                            <i class="fa-solid fa-ban"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        <tr id="emptySearchRow" class="d-none">
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="fa-regular fa-folder-open fs-3 d-block mb-2 opacity-50"></i>
                                Không tìm thấy phiếu nào phù hợp với bộ lọc tìm kiếm
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('voucherSearchInput');
        const statusFilter = document.getElementById('voucherStatusFilter');
        const rows = document.querySelectorAll('.voucher-row');
        const emptyRow = document.getElementById('emptySearchRow');
        const totalCount = document.getElementById('totalVoucherCount');

        function filterVouchers() {
            const query = (searchInput?.value || '').toLowerCase().trim();
            const status = (statusFilter?.value || '').trim();
            let visibleCount = 0;

            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                const rowStatus = row.getAttribute('data-status') || '';
                const matchQuery = !query || text.includes(query);
                const matchStatus = !status || rowStatus === status;

                if (matchQuery && matchStatus) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (emptyRow) {
                emptyRow.classList.toggle('d-none', visibleCount > 0);
            }
            if (totalCount) {
                totalCount.textContent = visibleCount;
            }
        }

        searchInput?.addEventListener('input', filterVouchers);
        statusFilter?.addEventListener('change', filterVouchers);
    });
</script>

<!-- Modal Từ chối duyệt được đặt bên ngoài bảng để hiển thị floating popup chuẩn Bootstrap -->
@foreach (var v in Model.Where(x => x.Status == "DRAFT" || x.Status == "PENDING"))
{
    <div class="modal fade" id="rejectModal_@v.VoucherId" tabindex="-1" aria-labelledby="rejectModalLabel_@v.VoucherId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form asp-action="Reject" asp-route-id="@v.VoucherId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title fw-bold" id="rejectModalLabel_@v.VoucherId">
                            <i class="fa-solid fa-ban me-2"></i>Từ chối duyệt phiếu xuất kho
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-light border d-flex justify-content-between align-items-center py-2 px-3 mb-3 small">
                            <div><span class="text-muted">Mã chứng từ:</span> <strong class="text-dark">@v.VoucherNumber</strong></div>
                            <div><span class="text-muted">Người lập:</span> <strong class="text-dark">@v.CreatedBy</strong></div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-secondary">
                                Lý do từ chối phê duyệt <span class="text-danger">*</span>:
                            </label>
                            <textarea name="reason" class="form-control" rows="3" placeholder="Nhập lý do từ chối duyệt phiếu xuất kho (tồn kho không đủ thực tế, sai thông tin khách hàng...)" required></textarea>
                            <div class="form-text small text-muted">
                                Lý do từ chối sẽ được lưu vĩnh viễn vào nhật ký kiểm toán hệ thống.
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light py-2">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa-solid fa-xmark me-1"></i> Hủy bỏ
                        </button>
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-ban me-1"></i> Xác nhận từ chối
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@{
    var rejectionLogs = ViewBag.RejectionLogs as Dictionary<string, DuAnCode.Web.Models.AuditLog> ?? new();
}

<!-- Modal Xem Chi Tiết Lý Do Từ Chối Duyệt -->
@foreach (var v in Model.Where(x => x.Status == "REJECTED"))
{
    var (origReason, rejReason) = DuAnCode.Web.Services.RejectionHelper.ExtractReason(v.Reason);
    var rejectLog = rejectionLogs.GetValueOrDefault(v.VoucherId);
    var rejectedBy = rejectLog?.PerformedBy ?? v.ApprovedBy ?? "Quản lý kho";
    var rejectedAt = rejectLog?.PerformedAt.ToLocalTime() ?? v.Date.ToLocalTime();

    <div class="modal fade" id="rejectionDetailModal_@v.VoucherId" tabindex="-1" aria-labelledby="rejectionDetailLabel_@v.VoucherId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold" id="rejectionDetailLabel_@v.VoucherId">
                        <i class="fa-solid fa-circle-xmark me-2"></i>Lý do từ chối duyệt phiếu xuất kho
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="card bg-light border-0 mb-3">
                        <div class="card-body p-3">
                            <div class="row g-2 small">
                                <div class="col-6">
                                    <span class="text-muted d-block">Mã chứng từ:</span>
                                    <strong class="text-dark fs-6">@v.VoucherNumber</strong>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted d-block">Trạng thái:</span>
                                    <span class="badge bg-danger">Đã từ chối duyệt</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted d-block">Người tạo:</span>
                                    <strong class="text-secondary">@(v.CreatedBy ?? "Không xác định")</strong>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted d-block">Thời gian tạo:</span>
                                    <span>@v.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <div class="col-6 border-top pt-2 mt-2">
                                    <span class="text-muted d-block"><i class="fa-solid fa-user-xmark text-danger me-1"></i>Người từ chối:</span>
                                    <strong class="text-danger">@rejectedBy</strong>
                                </div>
                                <div class="col-6 border-top pt-2 mt-2">
                                    <span class="text-muted d-block"><i class="fa-solid fa-clock text-danger me-1"></i>Thời gian từ chối:</span>
                                    <strong class="text-danger">@rejectedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-danger small text-uppercase">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>Lý do từ chối chi tiết:
                        </label>
                        <div class="p-3 bg-danger-subtle border border-danger-subtle rounded text-danger-emphasis fw-semibold">
                            @(string.IsNullOrWhiteSpace(rejReason) ? "Không có lý do cụ thể" : rejReason)
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(origReason))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small text-uppercase">
                                <i class="fa-solid fa-file-lines me-1"></i>Mục đích / Lý do ban đầu của phiếu:
                            </label>
                            <div class="p-2 bg-white border rounded text-secondary small">
                                @origReason
                            </div>
                        </div>
                    }

                    <div class="alert alert-warning py-2 px-3 small mb-0 d-flex align-items-center">
                        <i class="fa-solid fa-circle-info fs-5 me-2 text-warning flex-shrink-0"></i>
                        <div>
                            Phiếu này đã bị hủy hiệu lực. Số lượng hàng hóa <strong>không</strong> bị trừ khỏi kho.
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fa-solid fa-xmark me-1"></i> Đóng
                    </button>
                    <a asp-action="Create" asp-route-id="@v.VoucherId" class="btn btn-primary">
                        <i class="fa-solid fa-eye me-1"></i> Xem chi tiết chứng từ
                    </a>
                </div>
            </div>
        </div>
    </div>
}

