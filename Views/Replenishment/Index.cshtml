@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "AI Gợi ý nhập hàng & Cảnh báo";
}

<div class="container-fluid mt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-1"><i class="fa-solid fa-robot text-primary me-2"></i>Hệ thống AI Đề Xuất (Gợi ý nhập hàng & Cảnh báo)</h3>
            <p class="text-muted small mb-0">Tự động phân tích tồn kho, tốc độ xuất bán và cảnh báo nghẽn cấu kiện theo thời gian thực.</p>
        </div>
        <div>
            <form method="post" asp-action="RunAiScan" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary shadow-sm">
                    <i class="fa-solid fa-arrows-rotate me-1"></i> Quét & Phân tích AI ngay
                </button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 150px">Ngày phát hiện</th>
                            <th style="width: 180px">Loại cảnh báo</th>
                            <th>Hàng hóa / Đối tượng</th>
                            <th style="width: 170px">Tồn kho / Định mức</th>
                            <th style="width: 140px">Đề xuất nhập</th>
                            <th>Lý do (AI Phân tích)</th>
                            <th style="width: 130px" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-shield-halved text-success fa-3x mb-3 d-block"></i>
                                    <h5>Hiện tại không có đề xuất hay cảnh báo nào từ AI!</h5>
                                    <p class="small mb-0">Hệ thống kho đang ở trạng thái an toàn. Bạn có thể nhấn <b>"Quét & Phân tích AI ngay"</b> để kiểm tra lại.</p>
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted small">
                                    <i class="fa-regular fa-clock me-1"></i>@item.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @if (item.Type == "REPLENISHMENT")
                                    {
                                        <span class="badge bg-primary"><i class="fa-solid fa-cart-flatbed me-1"></i>Gợi ý nhập hàng</span>
                                    }
                                    else if (item.Type == "LOW_STOCK")
                                    {
                                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-triangle-exclamation me-1"></i>Dưới định mức tồn</span>
                                    }
                                    else if (item.Type == "ANOMALY")
                                    {
                                        <span class="badge bg-danger"><i class="fa-solid fa-chart-line me-1"></i>Biến động bất thường</span>
                                    }
                                    else if (item.Type == "BOTTLENECK")
                                    {
                                        <span class="badge bg-info text-dark"><i class="fa-solid fa-cubes-stacked me-1"></i>Nghẽn cổ chai Combo</span>
                                    }
                                    else if (item.Type == "CAPACITY_WARNING")
                                    {
                                        <span class="badge bg-secondary"><i class="fa-solid fa-warehouse me-1"></i>Sức chứa kho</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">@item.Type</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold">@item.ProductName</div>
                                    @if (!string.IsNullOrEmpty(item.Sku))
                                    {
                                        <span class="badge bg-light text-muted border">@item.Sku</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Type == "CAPACITY_WARNING")
                                    {
                                        <span>@item.CurrentStock% / @item.MinStock%</span>
                                    }
                                    else
                                    {
                                        <span>@item.CurrentStock / @item.MinStock</span>
                                    }
                                </td>
                                <td>
                                    @if (item.SuggestedQty > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success fs-6 fw-bold border border-success-subtle px-2 py-1">
                                            +@item.SuggestedQty
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="small">@item.Reason</td>
                                <td class="text-center">
                                    <form method="post" class="d-inline" asp-action="Approve" asp-route-id="@item.Id">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-sm btn-success btn-icon-only" type="submit" data-tooltip="Chấp thuận đề xuất & Tự động sinh phiếu nhập kho nháp">
                                            <i class="fa-solid fa-check" style="pointer-events: none;"></i>
                                        </button>
                                    </form>
                                    <form method="post" class="d-inline ms-1" asp-action="Reject" asp-route-id="@item.Id">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button class="btn btn-sm btn-outline-danger btn-icon-only" type="submit" data-tooltip="Bỏ qua cảnh báo/đề xuất này của AI">
                                            <i class="fa-solid fa-xmark" style="pointer-events: none;"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
