@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "AI Gợi ý nhập hàng & Cảnh báo";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Hệ thống AI Đề Xuất (Gợi ý nhập hàng & Cảnh báo)</h3>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Ngày phát hiện</th>
                            <th>Loại cảnh báo</th>
                            <th>Hàng hóa</th>
                            <th>Tồn kho / Định mức tối thiểu</th>
                            <th>Đề xuất (Số lượng)</th>
                            <th>Lý do (AI Phân tích)</th>
                            <th style="width: 200px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="7" class="text-center py-4">Hiện tại không có đề xuất nào từ AI. Hệ thống đang an toàn!</td></tr>
                        }
                        @foreach(var item in Model)
                        {
                            <tr>
                                <td>@item.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if(item.Type == "REPLENISHMENT")
                                    {
                                        <span class="badge bg-primary">Gợi ý nhập hàng</span>
                                    }
                                    else if (item.Type == "ANOMALY")
                                    {
                                        <span class="badge bg-danger">Biến động bất thường</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">@item.Type</span>
                                    }
                                </td>
                                <td class="fw-bold">@item.ProductName</td>
                                <td>@item.CurrentStock / @item.MinStock</td>
                                <td class="text-success fw-bold">@item.SuggestedQty</td>
                                <td>@item.Reason</td>
                                <td>
                                    <form method="post" class="d-inline" asp-action="Approve" asp-route-id="@item.Id">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-success" type="submit" title="Sinh phiếu nhập nháp"><i class="fa-solid fa-check"></i> Duyệt</button>
                                    </form>
                                    <form method="post" class="d-inline" asp-action="Reject" asp-route-id="@item.Id">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-danger" type="submit"><i class="fa-solid fa-xmark"></i> Bỏ qua</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
