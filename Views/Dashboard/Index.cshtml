@model DuAnCode.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan Tồn kho";
}

<div class="d-flex flex-column gap-4">
    <div class="row g-4">
        <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 border-0">
            <div class="card-body">
            <div class="text-muted small fw-semibold text-uppercase mb-2">Tổng mã SKU</div>
            <div class="fs-2 fw-bold text-primary">@Model.TotalSkus</div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 border-0">
            <div class="card-body">
            <div class="text-muted small fw-semibold text-uppercase mb-2">Tổng sản phẩm khả dụng</div>
            <div class="fs-2 fw-bold text-primary">@Model.TotalInventory</div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 border-0">
            <div class="card-body">
            <div class="text-muted small fw-semibold text-uppercase mb-2">Tồn hàng lỗi / hỏng</div>
            <div class="fs-2 fw-bold text-primary">@Model.Damaged</div>
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 border-0">
            <div class="card-body">
            <div class="text-muted small fw-semibold text-uppercase mb-2">Cảnh báo sắp hết hàng</div>
            <div class="fs-2 fw-bold text-primary">@Model.LowStockCount</div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="card h-100 border-0">
            <div class="card-body">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold">Tổng quan Tồn kho</h2>
            <div>
                <input id="searchBox" placeholder="Tìm mã SKU hoặc tên sản phẩm" class="border rounded px-3 py-1" />
            </div>
        </div>

        <table class="table table-striped">
            <thead class="table-light">
                <tr>
                    <th >Mã SKU</th>
                    <th >Sản phẩm</th>
                    <th >Kho lưu trữ</th>
                    <th >Trạng thái</th>
                    <th >Số lượng tồn</th>
                </tr>
            </thead>
            <tbody id="stockBody" class="bg-white divide-y divide-gray-100">
                @foreach(var s in Model.Ledgers)
                {
                    var statusText = s.Status == "GOOD" ? "Hàng tốt / Khả dụng" : s.Status == "DAMAGED" ? "Hàng lỗi / Hỏng" : s.Status;
                    <tr>
                        <td class="fw-bold">@s.SkuId</td>
                        <td >@s.ProductName</td>
                        <td >@s.WarehouseId</td>
                        <td >@statusText</td>
                        <td >@s.Quantity</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.getElementById('searchBox').addEventListener('input', function(){
        const q = this.value.toLowerCase();
        const rows = Array.from(document.querySelectorAll('#stockBody tr'));
        rows.forEach(r => {
            const text = r.innerText.toLowerCase();
            r.style.display = text.includes(q) ? '' : 'none';
        });
    });
</script>
