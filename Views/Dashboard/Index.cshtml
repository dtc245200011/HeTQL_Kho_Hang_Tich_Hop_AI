@model DuAnCode.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Tổng quan Tồn kho";
}

<div class="space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-4 rounded shadow">
            <div class="text-sm text-gray-500">Tổng mã SKU</div>
            <div class="text-2xl font-semibold">@Model.TotalSkus</div>
        </div>
        <div class="bg-white p-4 rounded shadow">
            <div class="text-sm text-gray-500">Tổng sản phẩm khả dụng</div>
            <div class="text-2xl font-semibold">@Model.TotalInventory</div>
        </div>
        <div class="bg-white p-4 rounded shadow">
            <div class="text-sm text-gray-500">Tồn hàng lỗi / hỏng</div>
            <div class="text-2xl font-semibold">@Model.Damaged</div>
        </div>
        <div class="bg-white p-4 rounded shadow">
            <div class="text-sm text-gray-500">Cảnh báo sắp hết hàng</div>
            <div class="text-2xl font-semibold">@Model.LowStockCount</div>
        </div>
    </div>

    <div class="bg-white p-4 rounded shadow">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold">Tổng quan Tồn kho</h2>
            <div>
                <input id="searchBox" placeholder="Tìm mã SKU hoặc tên sản phẩm" class="border rounded px-3 py-1" />
            </div>
        </div>

        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50 text-left text-sm text-gray-600">
                <tr>
                    <th class="px-4 py-2">Mã SKU</th>
                    <th class="px-4 py-2">Sản phẩm</th>
                    <th class="px-4 py-2">Kho lưu trữ</th>
                    <th class="px-4 py-2">Trạng thái</th>
                    <th class="px-4 py-2">Số lượng tồn</th>
                </tr>
            </thead>
            <tbody id="stockBody" class="bg-white divide-y divide-gray-100">
                @foreach(var s in Model.Ledgers)
                {
                    var statusText = s.Status == "GOOD" ? "Hàng tốt / Khả dụng" : s.Status == "DAMAGED" ? "Hàng lỗi / Hỏng" : s.Status;
                    <tr>
                        <td class="px-4 py-2 text-sm font-medium">@s.SkuId</td>
                        <td class="px-4 py-2 text-sm">@s.ProductName</td>
                        <td class="px-4 py-2 text-sm">@s.WarehouseId</td>
                        <td class="px-4 py-2 text-sm">@statusText</td>
                        <td class="px-4 py-2 text-sm">@s.Quantity</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.getElementById('searchBox').addEventListener('input', function(){
        const q = this.value.toLowerCase();
        const rows = Array.from(document.querySelectorAll('#stockBody tr'));
        rows.forEach(r => {
            const text = r.innerText.toLowerCase();
            r.style.display = text.includes(q) ? '' : 'none';
        });
    });
</script>
