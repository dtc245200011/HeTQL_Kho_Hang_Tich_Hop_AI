@model DuAnCode.Web.Models.ViewModels.ReportViewModel
@using DuAnCode.Web.Models.ViewModels
@using System.Linq
@{
    ViewData["Title"] = "Báo cáo Nhập - Xuất - Tồn";
    var warehouses = Model?.Warehouses ?? Enumerable.Empty<object>();
    var rows = Model?.ReportRows ?? Enumerable.Empty<ReportRow>();
}

<div class="bg-white p-4 rounded shadow max-w-5xl mx-auto">
    <h2 class="text-lg font-semibold mb-4">Báo cáo Nhập - Xuất - Tồn</h2>
    <form method="get" class="space-x-2 mb-4">
        <label class="text-sm">Từ ngày</label>
        <input type="date" name="from" class="border rounded px-2 py-1" />
        <label class="text-sm">Đến ngày</label>
        <input type="date" name="to" class="border rounded px-2 py-1" />
        <label class="text-sm">Kho</label>
        <select name="warehouse" class="border rounded px-2 py-1">
            <option value="">Tất cả</option>
            @foreach(var w in warehouses){ <option value="@((w as dynamic).WarehouseId)">@((w as dynamic).WarehouseName)</option> }
        </select>
        <button type="submit" class="bg-indigo-600 text-white px-3 py-1 rounded">Lọc</button>
    </form>

    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50 text-left text-sm text-gray-600">
            <tr>
                <th class="px-4 py-2">Mã SKU</th>
                <th class="px-4 py-2">Tồn đầu kỳ</th>
                <th class="px-4 py-2">Tổng Nhập trong kỳ</th>
                <th class="px-4 py-2">Tổng Xuất trong kỳ</th>
                <th class="px-4 py-2">Tồn cuối kỳ</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
            @foreach(var row in rows)
            {
                <tr>
                    <td class="px-4 py-2">@row.SkuId</td>
                    <td class="px-4 py-2">@row.Beginning</td>
                    <td class="px-4 py-2">@row.TotalIn</td>
                    <td class="px-4 py-2">@row.TotalOut</td>
                    <td class="px-4 py-2">@row.Ending</td>
                </tr>
            }
        </tbody>
    </table>
</div>
