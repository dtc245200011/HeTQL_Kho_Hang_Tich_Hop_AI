@model DuAnCode.Web.Models.ViewModels.ReportViewModel
@using DuAnCode.Web.Models.ViewModels
@using System.Linq
@{
    ViewData["Title"] = "Báo cáo Nhập - Xuất - Tồn";
    var warehouses = Model?.Warehouses ?? Enumerable.Empty<object>();
    var rows = Model?.ReportRows ?? Enumerable.Empty<ReportRow>();
}

<div class="container-fluid px-4 mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Báo cáo Tổng hợp Nhập - Xuất - Tồn (NXT)</h5>
            <span class="badge bg-white text-primary">@rows.Count() mặt hàng</span>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 mb-4 align-items-end">
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-secondary small text-uppercase">Từ ngày</label>
                    <input type="date" name="from" class="form-control" value="@ViewBag.From" />
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-secondary small text-uppercase">Đến ngày</label>
                    <input type="date" name="to" class="form-control" value="@ViewBag.To" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary small text-uppercase">Kho hàng</label>
                    <select name="warehouse" class="form-select">
                        <option value="">-- Tất cả các kho --</option>
                        @foreach(var w in warehouses){ 
                            <option value="@((w as dynamic).WarehouseId)" selected="@(((w as dynamic).WarehouseId == ViewBag.SelectedWarehouse) ? "selected" : null)">@((w as dynamic).WarehouseName)</option> 
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100" data-tooltip="Lọc và kết xuất dữ liệu báo cáo Nhập - Xuất - Tồn" data-tt-type="action">
                        <i class="fa-solid fa-filter me-1"></i> Lọc dữ liệu
                    </button>
                </div>
                <div class="col-md-2">
                    <a asp-action="ExportExcel" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" asp-route-warehouse="@ViewBag.SelectedWarehouse" class="btn btn-success w-100" data-tooltip="Tải file Excel (CSV UTF-8 BOM)">
                        <i class="fa-solid fa-file-excel me-1"></i> Xuất Excel
                    </a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th data-tooltip="Mã đơn vị lưu kho (Stock Keeping Unit)">Mã SKU</th>
                            <th data-tooltip="Tên quy chuẩn của sản phẩm">Tên hàng hóa</th>
                            <th style="width: 70px" class="text-center" data-tooltip="Đơn vị tính">ĐVT</th>
                            <th class="text-end" data-tooltip="Số lượng tồn kho tại thời điểm bắt đầu kỳ báo cáo">Tồn đầu kỳ</th>
                            <th class="text-end text-success" data-tooltip="Tổng số lượng hàng hóa nhập vào kho trong kỳ">Tổng Nhập</th>
                            <th class="text-end text-danger" data-tooltip="Tổng số lượng hàng hóa xuất ra khỏi kho trong kỳ">Tổng Xuất</th>
                            <th class="text-end text-primary" data-tooltip="Số lượng tồn kho thực tế tính đến cuối kỳ = Tồn đầu + Nhập - Xuất">Tồn cuối kỳ</th>
                            <th class="text-end text-success" data-tooltip="Tồn kho hàng tốt, đạt chuẩn chất lượng có thể xuất bán">Hàng tốt (GOOD)</th>
                            <th class="text-end text-danger" data-tooltip="Tồn kho hàng hỏng hóc, lỗi kỹ thuật đang bị cách ly">Hàng lỗi (QC)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(!rows.Any())
                        {
                            <tr><td colspan="9" class="text-center py-4 text-muted">Không có dữ liệu báo cáo phù hợp</td></tr>
                        }
                        @foreach(var row in rows)
                        {
                            <tr>
                                <td class="fw-bold">@row.SkuId</td>
                                <td>@row.ProductName</td>
                                <td class="text-center text-muted">@row.Unit</td>
                                <td class="text-end">@row.Beginning.ToString("N0")</td>
                                <td class="text-end text-success fw-semibold">@(row.TotalIn > 0 ? $"+{row.TotalIn:N0}" : "0")</td>
                                <td class="text-end text-danger fw-semibold">@(row.TotalOut > 0 ? $"-{row.TotalOut:N0}" : "0")</td>
                                <td class="text-end text-primary fw-bold">@row.Ending.ToString("N0")</td>
                                <td class="text-end text-success fw-semibold">@row.EndingGood.ToString("N0")</td>
                                <td class="text-end @(row.EndingDamaged > 0 ? "text-danger fw-bold" : "text-muted")">@row.EndingDamaged.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    @if (rows.Any())
                    {
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td colspan="3" class="text-end text-uppercase text-secondary">Tổng cộng toàn kỳ</td>
                                <td class="text-end">@rows.Sum(r => r.Beginning).ToString("N0")</td>
                                <td class="text-end text-success">+@rows.Sum(r => r.TotalIn).ToString("N0")</td>
                                <td class="text-end text-danger">-@rows.Sum(r => r.TotalOut).ToString("N0")</td>
                                <td class="text-end text-primary">@rows.Sum(r => r.Ending).ToString("N0")</td>
                                <td class="text-end text-success">@rows.Sum(r => r.EndingGood).ToString("N0")</td>
                                <td class="text-end text-danger">@rows.Sum(r => r.EndingDamaged).ToString("N0")</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
</div>
