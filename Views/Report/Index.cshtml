@model DuAnCode.Web.Models.ViewModels.ReportViewModel
@using DuAnCode.Web.Models.ViewModels
@using System.Linq
@{
    ViewData["Title"] = "Báo cáo Nhập - Xuất - Tồn";
    var warehouses = Model?.Warehouses ?? Enumerable.Empty<object>();
    var rows = Model?.ReportRows ?? Enumerable.Empty<ReportRow>();
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Báo cáo Nhập - Xuất - Tồn</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3 mb-4 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" name="from" class="form-control" value="@ViewBag.From" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" name="to" class="form-control" value="@ViewBag.To" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Kho hàng</label>
                    <select name="warehouse" class="form-select">
                        <option value="">Tất cả các kho</option>
                        @foreach(var w in warehouses){ 
                            <option value="@((w as dynamic).WarehouseId)" selected="@(((w as dynamic).WarehouseId == ViewBag.SelectedWarehouse) ? "selected" : null)">@((w as dynamic).WarehouseName)</option> 
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-filter"></i> Lọc dữ liệu</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Mã SKU</th>
                            <th class="text-end">Tồn đầu kỳ</th>
                            <th class="text-end">Tổng Nhập trong kỳ</th>
                            <th class="text-end">Tổng Xuất trong kỳ</th>
                            <th class="text-end text-primary">Tồn cuối kỳ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(!rows.Any())
                        {
                            <tr><td colspan="5" class="text-center">Không có dữ liệu báo cáo</td></tr>
                        }
                        @foreach(var row in rows)
                        {
                            <tr>
                                <td class="fw-bold">@row.SkuId</td>
                                <td class="text-end">@row.Beginning</td>
                                <td class="text-end text-success">@row.TotalIn</td>
                                <td class="text-end text-danger">@row.TotalOut</td>
                                <td class="text-end text-primary fw-bold">@row.Ending</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
