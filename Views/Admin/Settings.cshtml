@model DuAnCode.Web.Models.SettingsViewModel
@{
    ViewData["Title"] = "Cấu hình hệ thống";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold m-0"><i class="fa-solid fa-gears me-2 text-primary"></i>Cấu hình hệ thống</h3>
    </div>


    <div class="row">
        <!-- FORM CHÍNH CHO CÁC CẤU HÌNH HỆ THỐNG -->
        <div class="col-12">
            <form method="post" asp-controller="Admin" asp-action="SettingsPost">
                
                <!-- 1. Thông tin Doanh nghiệp -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor:pointer; user-select:none;" data-bs-toggle="collapse" data-bs-target="#collapseCompany">
                        <strong class="text-primary"><i class="fa-solid fa-building me-2"></i>Thông tin Doanh nghiệp</strong>
                        <i class="fa-solid fa-chevron-down text-muted transition-transform"></i>
                    </div>
                    <div class="collapse" id="collapseCompany">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Tên Công ty / Thương hiệu</label>
                                    <input name="Config.CompanyName" value="@Model?.Config?.CompanyName" class="form-control" placeholder="Tên Công ty" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Email quản lý</label>
                                    <input name="Config.Email" value="@Model?.Config?.Email" class="form-control" placeholder="email@company.com" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Số điện thoại</label>
                                    <input name="Config.Phone" value="@Model?.Config?.Phone" class="form-control" placeholder="Số điện thoại liên hệ" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Địa chỉ</label>
                                    <input name="Config.Address" value="@Model?.Config?.Address" class="form-control" placeholder="Địa chỉ công ty" />
                                </div>
                                <div class="col-12 mb-3">
                                    <div class="form-check form-switch">
                                        <input type="hidden" name="Config.AutoBackup" value="false" />
                                        <input class="form-check-input" type="checkbox" role="switch" name="Config.AutoBackup" id="AutoBackup" value="true" @(Model?.Config?.AutoBackup == true ? "checked" : "") />
                                        <label class="form-check-label" for="AutoBackup">Tự động sao lưu dữ liệu hệ thống (Hàng ngày)</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Thiết lập Dừng (Stop Configurations) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor:pointer; user-select:none;" data-bs-toggle="collapse" data-bs-target="#collapseStopConfig">
                        <strong class="text-danger"><i class="fa-solid fa-power-off me-2"></i>Thiết lập Dừng & Bảo trì</strong>
                        <i class="fa-solid fa-chevron-down text-muted transition-transform"></i>
                    </div>
                    <div class="collapse" id="collapseStopConfig">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-check form-switch mb-3">
                                        <input type="hidden" name="Config.MaintenanceMode" value="false" />
                                        <input class="form-check-input" type="checkbox" role="switch" name="Config.MaintenanceMode" id="MaintenanceMode" value="true" @(Model?.Config?.MaintenanceMode == true ? "checked" : "")>
                                        <label class="form-check-label fw-bold text-danger" for="MaintenanceMode">Bật chế độ bảo trì hệ thống</label>
                                        <div class="form-text">Khóa truy cập với toàn bộ nhân viên, chỉ Admin được phép sử dụng.</div>
                                    </div>
                                    <div class="form-check form-switch mb-3">
                                        <input type="hidden" name="Config.StopInbound" value="false" />
                                        <input class="form-check-input" type="checkbox" role="switch" name="Config.StopInbound" id="StopInbound" value="true" @(Model?.Config?.StopInbound == true ? "checked" : "")>
                                        <label class="form-check-label fw-semibold" for="StopInbound">Dừng tiếp nhận Phiếu Nhập Kho mới</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch mb-3">
                                        <input type="hidden" name="Config.StopOutbound" value="false" />
                                        <input class="form-check-input" type="checkbox" role="switch" name="Config.StopOutbound" id="StopOutbound" value="true" @(Model?.Config?.StopOutbound == true ? "checked" : "")>
                                        <label class="form-check-label fw-semibold" for="StopOutbound">Dừng tạo Phiếu Xuất Kho mới</label>
                                    </div>
                                    <div class="form-check form-switch mb-3">
                                        <input type="hidden" name="Config.StopApi" value="false" />
                                        <input class="form-check-input" type="checkbox" role="switch" name="Config.StopApi" id="StopApi" value="true" @(Model?.Config?.StopApi == true ? "checked" : "")>
                                        <label class="form-check-label fw-semibold" for="StopApi">Khóa cổng API kết nối từ bên thứ ba</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Thiết lập Cảnh báo (Alerts) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor:pointer; user-select:none;" data-bs-toggle="collapse" data-bs-target="#collapseAlerts">
                        <strong class="text-warning"><i class="fa-solid fa-bell me-2"></i>Thiết lập Cảnh báo</strong>
                        <i class="fa-solid fa-chevron-down text-muted transition-transform"></i>
                    </div>
                    <div class="collapse" id="collapseAlerts">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Ngưỡng tồn kho tối thiểu (Low stock alert)</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" name="Config.LowStockAlertThreshold" value="@(Model?.Config?.LowStockAlertThreshold ?? 10)" placeholder="Số lượng">
                                        <span class="input-group-text">Đơn vị</span>
                                    </div>
                                    <div class="form-text">Cảnh báo nếu sản phẩm có số lượng tồn dưới mức này.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Ngưỡng sức chứa kho (Capacity alert)</label>
                                    <div class="input-group">
                                        <input type="number" class="form-control" name="Config.CapacityAlertPercent" value="@(Model?.Config?.CapacityAlertPercent ?? 90)" placeholder="Phần trăm">
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <div class="form-text">Cảnh báo khi sức chứa của kho đạt mức tỷ lệ này.</div>
                                </div>
                                <div class="col-12 mb-3">
                                    <div class="form-check form-switch">
                                        <input type="hidden" name="Config.EnableEmailAlerts" value="false" />
                                        <input class="form-check-input" type="checkbox" role="switch" name="Config.EnableEmailAlerts" id="EnableEmailAlerts" value="true" @((Model?.Config?.EnableEmailAlerts ?? true) ? "checked" : "")>
                                        <label class="form-check-label fw-semibold" for="EnableEmailAlerts">Gửi email cho Quản trị viên khi có cảnh báo</label>
                                    </div>
                                </div>
                                <div class="col-12 mb-3">
                                    <label class="form-label fw-semibold">Tài khoản gửi Email (SMTP)</label>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (string.IsNullOrEmpty(ViewBag.SmtpEmail))
                                        {
                                            <span class="text-muted fst-italic">Chưa cấu hình</span>
                                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#modalSmtpConfig">
                                                <i class="fa-solid fa-plus me-1"></i> Thêm Email
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-success">@ViewBag.SmtpEmail</span>
                                            <button type="button" class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#modalSmtpConfig">
                                                <i class="fa-solid fa-pen me-1"></i> Đổi Email
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4. Cấu hình Quy trình Phê duyệt (Approval Workflow) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor:pointer; user-select:none;" data-bs-toggle="collapse" data-bs-target="#collapseApproval">
                        <strong style="color: #4f46e5;"><i class="fa-solid fa-stamp me-2"></i>Cấu hình Quy trình Phê duyệt Chứng Từ</strong>
                        <i class="fa-solid fa-chevron-down text-muted transition-transform"></i>
                    </div>
                    <div class="collapse" id="collapseApproval">
                        <div class="card-body">
                            <!-- Visual Workflow Preview -->
                            <div class="p-3 mb-4 rounded-3 border" style="background: linear-gradient(135deg, #f8faff 0%, #f1f5f9 100%);">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                    <span class="fw-bold text-dark small text-uppercase"><i class="fa-solid fa-diagram-project text-primary me-2"></i>Sơ đồ Quy trình Phê duyệt Mô phỏng</span>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small" id="workflowStatusBadge">Quy trình phân cấp đang BẬT</span>
                                </div>
                                <div class="d-flex align-items-center justify-content-center flex-wrap gap-2 py-2 text-center" id="workflowPipelinePreview">
                                    <div class="px-3 py-2 bg-white rounded shadow-sm border border-light-subtle">
                                        <div class="small text-muted fw-semibold">Khởi tạo</div>
                                        <div class="fw-bold text-secondary"><i class="fa-solid fa-file-lines me-1"></i>Bản nháp (DRAFT)</div>
                                    </div>
                                    <i class="fa-solid fa-arrow-right text-muted"></i>
                                    <div class="px-3 py-2 bg-white rounded shadow-sm border border-primary-subtle" id="previewStep1">
                                        <div class="small text-primary fw-semibold">Cấp 1: Kiểm duyệt sơ bộ</div>
                                        <div class="fw-bold text-dark" id="previewRole1">
                                            <i class="fa-solid fa-calculator text-primary me-1"></i>@(Model?.Config?.ApprovalRoleLevel1 == "Accountant" ? "Kế toán" : (Model?.Config?.ApprovalRoleLevel1 ?? "Kế toán"))
                                        </div>
                                    </div>
                                    <i class="fa-solid fa-arrow-right text-muted" id="previewArrow1"></i>
                                    <div class="px-3 py-2 bg-white rounded shadow-sm border border-info-subtle" id="previewStep2">
                                        <div class="small text-info fw-semibold">Cấp 2: Quản lý kho duyệt</div>
                                        <div class="fw-bold text-dark" id="previewRole2">
                                            <i class="fa-solid fa-user-tie text-info me-1"></i>@(Model?.Config?.ApprovalRoleLevel2 == "WarehouseManager" ? "Quản lý kho" : (Model?.Config?.ApprovalRoleLevel2 ?? "Quản lý kho"))
                                        </div>
                                    </div>
                                    <i class="fa-solid fa-arrow-right text-muted" id="previewArrow2"></i>
                                    <div class="px-3 py-2 bg-white rounded shadow-sm border border-warning-subtle" id="previewStep3">
                                        <div class="small text-warning fw-semibold">Cấp 3: Giám đốc duyệt (&gt; Ngưỡng)</div>
                                        <div class="fw-bold text-dark" id="previewRole3">
                                            <i class="fa-solid fa-crown text-warning me-1"></i>@(Model?.Config?.ApprovalRoleLevel3 == "Director" ? "Giám đốc" : (Model?.Config?.ApprovalRoleLevel3 ?? "Giám đốc"))
                                        </div>
                                    </div>
                                    <i class="fa-solid fa-arrow-right text-muted"></i>
                                    <div class="px-3 py-2 bg-success text-white rounded shadow-sm">
                                        <div class="small opacity-75">Hoàn tất</div>
                                        <div class="fw-bold"><i class="fa-solid fa-circle-check me-1"></i>Đã duyệt (APPROVED)</div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3">
                                <!-- Switch 1: Multi-level toggle -->
                                <div class="col-md-6">
                                    <div class="form-check form-switch mb-3 p-3 bg-light rounded border">
                                        <input type="hidden" name="Config.EnableMultiLevelApproval" value="false" />
                                        <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" name="Config.EnableMultiLevelApproval" id="EnableMultiLevelApproval" value="true" @((Model?.Config?.EnableMultiLevelApproval ?? true) ? "checked" : "") onchange="updateWorkflowPreview()">
                                        <label class="form-check-label fw-bold text-dark" for="EnableMultiLevelApproval">
                                            <i class="fa-solid fa-layer-group text-primary me-1"></i>Bật Quy trình Phê duyệt Nhiều Cấp
                                        </label>
                                        <div class="form-text mt-1 text-muted">
                                            Bắt buộc chứng từ phải qua đủ các cấp phê duyệt tuần tự (Cấp 1 ➔ Cấp 2 ➔ Cấp 3). Nếu tắt, chỉ cần cấp phê duyệt quyết định (Cấp 2) là hoàn tất.
                                        </div>
                                    </div>
                                </div>

                                <!-- Switch 2: Inbound multi-level toggle -->
                                <div class="col-md-6">
                                    <div class="form-check form-switch mb-3 p-3 bg-light rounded border">
                                        <input type="hidden" name="Config.InboundRequireApproval" value="false" />
                                        <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" name="Config.InboundRequireApproval" id="InboundRequireApproval" value="true" @((Model?.Config?.InboundRequireApproval ?? true) ? "checked" : "")>
                                        <label class="form-check-label fw-bold text-dark" for="InboundRequireApproval">
                                            <i class="fa-solid fa-dolly text-success me-1"></i>Áp dụng 2 cấp duyệt cho Phiếu Nhập Kho
                                        </label>
                                        <div class="form-text mt-1 text-muted">
                                            Kế toán kiểm tra chứng từ nhà cung cấp (Cấp 1) trước khi Quản lý kho duyệt chính thức cập nhật tồn (Cấp 2).
                                        </div>
                                    </div>
                                </div>

                                <!-- Switch 3: Stock transfer toggle -->
                                <div class="col-md-6">
                                    <div class="form-check form-switch mb-3 p-3 bg-light rounded border">
                                        <input type="hidden" name="Config.TransferRequireApproval" value="false" />
                                        <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" name="Config.TransferRequireApproval" id="TransferRequireApproval" value="true" @((Model?.Config?.TransferRequireApproval ?? true) ? "checked" : "")>
                                        <label class="form-check-label fw-bold text-dark" for="TransferRequireApproval">
                                            <i class="fa-solid fa-arrow-right-arrow-left text-info me-1"></i>Yêu cầu duyệt Phiếu Chuyển Kho nội bộ
                                        </label>
                                        <div class="form-text mt-1 text-muted">
                                            Phiếu chuyển giữa các kho phải được phê duyệt trước khi hàng được trừ tại kho xuất và cộng tại kho đích.
                                        </div>
                                    </div>
                                </div>

                                <!-- Switch 4: Auto approve low value outbound -->
                                <div class="col-md-6">
                                    <div class="form-check form-switch mb-3 p-3 bg-light rounded border">
                                        <input type="hidden" name="Config.AutoApproveLowValueOutbound" value="false" />
                                        <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" name="Config.AutoApproveLowValueOutbound" id="AutoApproveLowValueOutbound" value="true" @((Model?.Config?.AutoApproveLowValueOutbound ?? false) ? "checked" : "")>
                                        <label class="form-check-label fw-bold text-dark" for="AutoApproveLowValueOutbound">
                                            <i class="fa-solid fa-bolt text-warning me-1"></i>Tự động duyệt Phiếu Xuất giá trị nhỏ
                                        </label>
                                        <div class="form-text mt-1 text-muted">
                                            Tự động duyệt các phiếu xuất có tổng giá trị nhỏ hơn hoặc bằng ngưỡng quy định bên dưới.
                                        </div>
                                    </div>
                                </div>

                                <!-- Input: Director threshold -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-dark">
                                        <i class="fa-solid fa-crown text-warning me-1"></i>Ngưỡng giá trị bắt buộc Giám đốc duyệt (VNĐ)
                                    </label>
                                    <div class="input-group">
                                        <input type="number" step="1000000" class="form-control" name="Config.OutboundDirectorApprovalThreshold" id="OutboundDirectorApprovalThreshold" value="@(Model?.Config?.OutboundDirectorApprovalThreshold > 0 ? Model.Config.OutboundDirectorApprovalThreshold : 100000000M)" placeholder="100000000">
                                        <span class="input-group-text fw-semibold">VNĐ</span>
                                    </div>
                                    <div class="form-text">Mặc định: 100.000.000 VNĐ. Phiếu xuất vượt mức này sẽ yêu cầu chữ ký Cấp 3 (Giám đốc).</div>
                                </div>

                                <!-- Input: Auto approve threshold -->
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-dark">
                                        <i class="fa-solid fa-shield-halved text-secondary me-1"></i>Ngưỡng tự động duyệt tối đa (VNĐ)
                                    </label>
                                    <div class="input-group">
                                        <input type="number" step="500000" class="form-control" name="Config.AutoApproveThreshold" value="@(Model?.Config?.AutoApproveThreshold ?? 0M)" placeholder="0">
                                        <span class="input-group-text fw-semibold">VNĐ</span>
                                    </div>
                                    <div class="form-text">Chỉ áp dụng khi bật tùy chọn "Tự động duyệt Phiếu Xuất giá trị nhỏ". Đặt 0 để tắt.</div>
                                </div>

                                <div class="col-12 mt-2">
                                    <hr class="text-muted opacity-25">
                                    <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-users-gear text-primary me-2"></i>Chỉ định Vai trò Phê duyệt theo từng Cấp</h6>
                                </div>

                                <!-- Role Level 1 -->
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-primary">
                                        <i class="fa-solid fa-1 me-1"></i>Vai trò duyệt Cấp 1 (Sơ bộ)
                                    </label>
                                    <select name="Config.ApprovalRoleLevel1" id="ApprovalRoleLevel1" class="form-select border-primary-subtle" onchange="updateWorkflowPreview()">
                                        <option value="Accountant" selected="@((Model?.Config?.ApprovalRoleLevel1 ?? "Accountant") == "Accountant")">Kế toán (Accountant)</option>
                                        <option value="WarehouseKeeper" selected="@(Model?.Config?.ApprovalRoleLevel1 == "WarehouseKeeper")">Thủ kho (WarehouseKeeper)</option>
                                        <option value="QC" selected="@(Model?.Config?.ApprovalRoleLevel1 == "QC")">Kiểm định chất lượng (QC)</option>
                                        <option value="WarehouseManager" selected="@(Model?.Config?.ApprovalRoleLevel1 == "WarehouseManager")">Quản lý kho (WarehouseManager)</option>
                                    </select>
                                    <div class="form-text">Đối chiếu số liệu chứng từ ban đầu.</div>
                                </div>

                                <!-- Role Level 2 -->
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-info">
                                        <i class="fa-solid fa-2 me-1"></i>Vai trò duyệt Cấp 2 (Quản lý kho)
                                    </label>
                                    <select name="Config.ApprovalRoleLevel2" id="ApprovalRoleLevel2" class="form-select border-info-subtle" onchange="updateWorkflowPreview()">
                                        <option value="WarehouseManager" selected="@((Model?.Config?.ApprovalRoleLevel2 ?? "WarehouseManager") == "WarehouseManager")">Quản lý kho (WarehouseManager)</option>
                                        <option value="Accountant" selected="@(Model?.Config?.ApprovalRoleLevel2 == "Accountant")">Kế toán (Accountant)</option>
                                        <option value="Director" selected="@(Model?.Config?.ApprovalRoleLevel2 == "Director")">Giám đốc (Director)</option>
                                        <option value="Admin" selected="@(Model?.Config?.ApprovalRoleLevel2 == "Admin")">Quản trị viên (Admin)</option>
                                    </select>
                                    <div class="form-text">Chịu trách nhiệm xuất / nhập kho thực tế.</div>
                                </div>

                                <!-- Role Level 3 -->
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold text-warning">
                                        <i class="fa-solid fa-3 me-1"></i>Vai trò duyệt Cấp 3 (Giám đốc)
                                    </label>
                                    <select name="Config.ApprovalRoleLevel3" id="ApprovalRoleLevel3" class="form-select border-warning-subtle" onchange="updateWorkflowPreview()">
                                        <option value="Director" selected="@((Model?.Config?.ApprovalRoleLevel3 ?? "Director") == "Director")">Giám đốc (Director)</option>
                                        <option value="WarehouseManager" selected="@(Model?.Config?.ApprovalRoleLevel3 == "WarehouseManager")">Quản lý kho (WarehouseManager)</option>
                                        <option value="Admin" selected="@(Model?.Config?.ApprovalRoleLevel3 == "Admin")">Quản trị viên (Admin)</option>
                                    </select>
                                    <div class="form-text">Phê duyệt đơn hàng / phiếu xuất giá trị lớn.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. Cấu hình Tiền tố Mã Chứng Từ (Prefix) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor:pointer; user-select:none;" data-bs-toggle="collapse" data-bs-target="#collapsePrefix">
                        <strong class="text-info"><i class="fa-solid fa-file-invoice-dollar me-2"></i>Cấu hình Tiền tố Mã Chứng Từ</strong>
                        <i class="fa-solid fa-chevron-down text-muted transition-transform"></i>
                    </div>
                    <div class="collapse" id="collapsePrefix">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Tiền tố Phiếu Nhập Kho</label>
                                    <input type="text" class="form-control" name="Config.InboundPrefix" value="@(Model?.Config?.InboundPrefix ?? "PN-")" placeholder="VD: PN-">
                                    <div class="form-text">Mã phiếu tự sinh sẽ có dạng: <strong>@(Model?.Config?.InboundPrefix ?? "PN-")20231015...</strong></div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Tiền tố Phiếu Xuất Kho</label>
                                    <input type="text" class="form-control" name="Config.OutboundPrefix" value="@(Model?.Config?.OutboundPrefix ?? "PX-")" placeholder="VD: PX-">
                                    <div class="form-text">Mã phiếu tự sinh sẽ có dạng: <strong>@(Model?.Config?.OutboundPrefix ?? "PX-")20231015...</strong></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. Cấu hình In tem nhãn (Barcode/QR) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor:pointer; user-select:none;" data-bs-toggle="collapse" data-bs-target="#collapseBarcode">
                        <strong class="text-secondary"><i class="fa-solid fa-barcode me-2"></i>Cấu hình In tem nhãn</strong>
                        <i class="fa-solid fa-chevron-down text-muted transition-transform"></i>
                    </div>
                    <div class="collapse" id="collapseBarcode">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold">Định dạng mã vạch</label>
                                    <select name="Config.BarcodeFormat" class="form-select">
                                        <option value="QR" selected="@(Model?.Config?.BarcodeFormat == "QR")">Mã QR Code</option>
                                        <option value="BARCODE" selected="@(Model?.Config?.BarcodeFormat == "BARCODE")">Mã vạch đứng (Barcode)</option>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold">Chiều rộng tem (mm)</label>
                                    <input type="number" class="form-control" name="Config.LabelWidth" value="@(Model?.Config?.LabelWidth > 0 ? Model.Config.LabelWidth : 50)">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold">Chiều cao tem (mm)</label>
                                    <input type="number" class="form-control" name="Config.LabelHeight" value="@(Model?.Config?.LabelHeight > 0 ? Model.Config.LabelHeight : 50)">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-check form-switch">
                                        <input type="hidden" name="Config.PrintPriceOnLabel" value="false" />
                                        <input class="form-check-input" type="checkbox" role="switch" name="Config.PrintPriceOnLabel" id="PrintPriceOnLabel" value="true" @((Model?.Config?.PrintPriceOnLabel ?? true) ? "checked" : "")>
                                        <label class="form-check-label fw-semibold" for="PrintPriceOnLabel">Hiển thị Đơn giá trên tem</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-check form-switch">
                                        <input type="hidden" name="Config.PrintExpiryOnLabel" value="false" />
                                        <input class="form-check-input" type="checkbox" role="switch" name="Config.PrintExpiryOnLabel" id="PrintExpiryOnLabel" value="true" @((Model?.Config?.PrintExpiryOnLabel ?? true) ? "checked" : "")>
                                        <label class="form-check-label fw-semibold" for="PrintExpiryOnLabel">Hiển thị Hạn sử dụng trên tem</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 6. Cấu hình kết nối Ollama (AI) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor:pointer; user-select:none;" data-bs-toggle="collapse" data-bs-target="#collapseOllama">
                        <strong class="text-primary"><i class="fa-solid fa-robot me-2"></i>Cấu hình kết nối Ollama (AI)</strong>
                        <i class="fa-solid fa-chevron-down text-muted transition-transform"></i>
                    </div>
                    <div class="collapse" id="collapseOllama">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-5 mb-3">
                                    <label class="form-label fw-semibold">Địa chỉ Máy chủ Ollama (URL)</label>
                                    <input type="text" class="form-control" name="Config.OllamaUrl" value="@(string.IsNullOrWhiteSpace(Model?.Config?.OllamaUrl) ? "http://localhost:11434" : Model.Config.OllamaUrl)" placeholder="http://localhost:11434">
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label fw-semibold">Mô hình Ngôn ngữ (Model)</label>
                                    <input type="text" class="form-control" name="Config.OllamaModel" value="@(string.IsNullOrWhiteSpace(Model?.Config?.OllamaModel) ? "qwen2.5-coder:7b" : Model.Config.OllamaModel)" placeholder="VD: qwen2.5-coder:7b">
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label fw-semibold">Tần suất quét (phút)</label>
                                    <input type="number" class="form-control" name="Config.AiScanIntervalMinutes" value="@(Model?.Config?.AiScanIntervalMinutes > 0 ? Model.Config.AiScanIntervalMinutes : 30)">
                                    <div class="form-text">Mặc định: 30 phút.</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 7. Cấu hình Đa ngôn ngữ (I18N) -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor:pointer; user-select:none;" data-bs-toggle="collapse" data-bs-target="#collapseLanguage">
                        <strong class="text-success"><i class="fa-solid fa-language me-2"></i>Cấu hình Đa ngôn ngữ & Khu vực</strong>
                        <i class="fa-solid fa-chevron-down text-muted transition-transform"></i>
                    </div>
                    <div class="collapse" id="collapseLanguage">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Ngôn ngữ mặc định</label>
                                    <select name="Config.DefaultLanguage" class="form-select">
                                        <option value="vi-VN" selected="@(Model?.Config?.DefaultLanguage == "vi-VN")">Tiếng Việt (vi-VN)</option>
                                        <option value="en-US" selected="@(Model?.Config?.DefaultLanguage == "en-US")">English (en-US)</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Định dạng Tiền tệ</label>
                                    <select name="Config.CurrencyFormat" class="form-select">
                                        <option value="VND" selected="@(Model?.Config?.CurrencyFormat == "VND")">Việt Nam Đồng (VND)</option>
                                        <option value="USD" selected="@(Model?.Config?.CurrencyFormat == "USD")">Đô la Mỹ (USD)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Sticky Save Button for System Configs -->
                <div class="position-sticky bottom-0 bg-white p-3 shadow-lg border-top rounded text-end mb-4 z-3">
                    <button type="submit" class="btn btn-primary px-5 fw-bold"><i class="fa-solid fa-floppy-disk me-2"></i>Lưu toàn bộ Cấu hình Hệ thống</button>
                </div>
            </form>
        </div>

        <!-- 4. Quản lý Kho hàng -->
        <div class="col-12 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex justify-content-between align-items-center" style="cursor:pointer; user-select:none;" data-bs-toggle="collapse" data-bs-target="#collapseWarehouse">
                    <strong class="text-success"><i class="fa-solid fa-warehouse me-2"></i>Quản lý Kho hàng</strong>
                    <i class="fa-solid fa-chevron-down text-muted transition-transform"></i>
                </div>
                <div class="collapse" id="collapseWarehouse">
                    <div class="card-body">
                        <div class="row">
                            <!-- Form thêm kho -->
                            <div class="col-12 mb-4">
                                <h6 class="fw-bold text-primary mb-3 text-uppercase">Thêm kho hàng mới</h6>
                                <form method="post" asp-controller="Admin" asp-action="AddWarehouse">
                                    <div class="row g-3">
                                        <div class="col-md-3">
                                            <label class="form-label text-muted small fw-semibold text-uppercase">Mã kho (ID)</label>
                                            <input name="code" placeholder="VD: WH-01" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label text-muted small fw-semibold text-uppercase">Tên kho</label>
                                            <input name="name" placeholder="VD: Kho chính Hà Nội" class="form-control form-control-sm" required />
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label text-muted small fw-semibold text-uppercase">Phân loại</label>
                                            <select name="type" class="form-select form-select-sm">
                                                <option value="MAIN">Kho chính</option>
                                                <option value="DAMAGED">Kho lỗi</option>
                                                <option value="QC">Kho kiểm định</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label text-muted small fw-semibold text-uppercase">Sức chứa (CBM)</label>
                                            <input name="capacity" type="number" step="0.01" class="form-control form-control-sm" value="100" />
                                        </div>
                                        <div class="col-md-9 mt-3">
                                            <label class="form-label text-muted small fw-semibold text-uppercase">Vị trí (Location)</label>
                                            <input name="location" placeholder="Tọa độ hoặc địa chỉ" class="form-control form-control-sm" />
                                        </div>
                                        <div class="col-md-3 mt-3 d-flex align-items-end">
                                            <button class="btn btn-primary shadow-sm fw-semibold w-100">Thêm kho</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                            
                            <hr class="text-muted" />

                            <!-- Table danh sách -->
                            <div class="col-12 mt-3">
                                <h6 class="fw-bold text-primary mb-3 text-uppercase">Danh sách kho hiện tại</h6>
                                <div class="table-responsive border rounded shadow-sm">
                                    <table class="table table-hover table-sm align-middle mb-0" id="warehouseTable">
                                        <thead class="table-light">
                                            <tr>
                                                <th style="padding: 0.4rem 0.3rem !important;">Mã kho</th>
                                                <th style="padding: 0.4rem 0.3rem !important;">Tên kho</th>
                                                <th style="padding: 0.4rem 0.3rem !important;">Loại</th>
                                                <th style="padding: 0.4rem 0.3rem !important;">Sức chứa</th>
                                                <th class="text-center" style="width:80px; padding: 0.4rem 0.3rem !important;">&nbsp;</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model?.Warehouses != null && Model.Warehouses.Any())
                                            {
                                                foreach(var w in Model.Warehouses)
                                                {
                                                <tr>
                                                    <td style="padding: 0.4rem 0.3rem !important;"><span class="fw-semibold">@w.WarehouseId</span></td>
                                                    <td style="padding: 0.4rem 0.3rem !important;">@w.WarehouseName</td>
                                                    <td style="padding: 0.4rem 0.3rem !important;"><span class="badge bg-secondary">@w.WarehouseType</span></td>
                                                    <td style="padding: 0.4rem 0.3rem !important;">@w.MaxCapacityCbm CBM</td>
                                                    <td class="text-center" style="padding: 0.4rem 0.3rem !important;">
                                                        <form method="post" asp-controller="Admin" asp-action="DeleteWarehouse" style="display:inline">
                                                            <input type="hidden" name="id" value="@w.WarehouseId" />
                                                            <button class="btn btn-sm btn-danger remove-line" onclick="return confirm('Bạn có chắc muốn xóa kho này?');">-</button>
                                                        </form>
                                                    </td>
                                                </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="modalSmtpConfig" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="UpdateSmtpConfig" asp-controller="Admin" method="post">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Cấu hình Gửi Email (SMTP)</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tài khoản Email</label>
                        <input type="email" class="form-control" name="SmtpEmail" required placeholder="Nhập email của bạn (vd: abc@gmail.com)" value="@(string.IsNullOrEmpty(ViewBag.SmtpEmail) ? "" : ViewBag.SmtpEmail)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu Ứng dụng</label>
                        <input type="password" class="form-control" name="SmtpPassword" required placeholder="Nhập mật khẩu ứng dụng 16 ký tự" />
                        <div class="form-text">Mật khẩu này không được hiển thị lại vì lý do bảo mật. Vui lòng lấy "Mật khẩu ứng dụng" thay vì dùng mật khẩu đăng nhập gốc (đặc biệt với Gmail).</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">Lưu cấu hình</button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function updateWorkflowPreview() {
        const isMulti = document.getElementById('EnableMultiLevelApproval')?.checked;
        const role1Select = document.getElementById('ApprovalRoleLevel1');
        const role2Select = document.getElementById('ApprovalRoleLevel2');
        const role3Select = document.getElementById('ApprovalRoleLevel3');

        const role1Text = role1Select ? role1Select.options[role1Select.selectedIndex]?.text.split('(')[0].trim() : 'Kế toán';
        const role2Text = role2Select ? role2Select.options[role2Select.selectedIndex]?.text.split('(')[0].trim() : 'Quản lý kho';
        const role3Text = role3Select ? role3Select.options[role3Select.selectedIndex]?.text.split('(')[0].trim() : 'Giám đốc';

        const pRole1 = document.getElementById('previewRole1');
        const pRole2 = document.getElementById('previewRole2');
        const pRole3 = document.getElementById('previewRole3');
        const pStep1 = document.getElementById('previewStep1');
        const pArrow1 = document.getElementById('previewArrow1');
        const statusBadge = document.getElementById('workflowStatusBadge');

        if (pRole1) pRole1.innerHTML = `<i class="fa-solid fa-calculator text-primary me-1"></i>${role1Text}`;
        if (pRole2) pRole2.innerHTML = `<i class="fa-solid fa-user-tie text-info me-1"></i>${role2Text}`;
        if (pRole3) pRole3.innerHTML = `<i class="fa-solid fa-crown text-warning me-1"></i>${role3Text}`;

        if (statusBadge) {
            if (isMulti) {
                statusBadge.className = "badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small";
                statusBadge.innerText = "Quy trình phân cấp đang BẬT";
            } else {
                statusBadge.className = "badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 small";
                statusBadge.innerText = "Quy trình phân cấp đang TẮT (Chỉ 1 cấp duyệt kho)";
            }
        }

        if (pStep1 && pArrow1) {
            if (isMulti) {
                pStep1.style.display = "block";
                pArrow1.style.display = "inline-block";
            } else {
                pStep1.style.display = "none";
                pArrow1.style.display = "none";
            }
        }
    }
    document.addEventListener("DOMContentLoaded", updateWorkflowPreview);
</script>

