@model DuAnCode.Web.Models.SettingsViewModel
@{
    ViewData["Title"] = "Cấu hình hệ thống";
}
<div class="container mt-4">
    <h3>Cấu hình kho</h3>
    @if(TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if(TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if(TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    <form method="post" asp-controller="Admin" asp-action="SettingsPost">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Thông tin Doanh nghiệp</label>
                    <input name="Config.CompanyName" value="@Model?.Config?.CompanyName" class="form-control" placeholder="Tên Công ty / Thương hiệu" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Địa chỉ</label>
                    <input name="Config.Address" value="@Model?.Config?.Address" class="form-control" placeholder="Địa chỉ công ty" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Số điện thoại</label>
                    <input name="Config.Phone" value="@Model?.Config?.Phone" class="form-control" placeholder="Số điện thoại liên hệ" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email quản lý</label>
                    <input name="Config.Email" value="@Model?.Config?.Email" class="form-control" placeholder="email@company.com" />
                </div>
                <div class="form-check form-switch mb-3">
                    <input type="hidden" name="Config.AutoBackup" value="false" />
                    <input class="form-check-input" type="checkbox" role="switch" name="Config.AutoBackup" id="AutoBackup" value="true" @(Model?.Config?.AutoBackup == true ? "checked" : "") />
                    <label class="form-check-label" for="AutoBackup">Tự động sao lưu dữ liệu</label>
                </div>
                <button type="submit" class="btn btn-primary">Lưu cấu hình</button>
            </div>
            <div class="col-md-6">
                <h5>Danh sách kho</h5>
                <table class="table table-sm">
                    <thead><tr><th>Mã kho</th><th>Tên kho</th><th>Loại kho</th><th>Sức chứa tối đa (CBM)</th><th></th></tr></thead>
                    <tbody>
                        @if (Model?.Warehouses != null && Model.Warehouses.Any())
                        {
                            foreach(var w in Model.Warehouses)
                            {
                            <tr>
                                <td>@w.WarehouseId</td>
                                <td>@w.WarehouseName</td>
                                <td>@w.WarehouseType</td>
                                <td>@w.MaxCapacityCbm</td>
                                <td>
                                    <form method="post" asp-controller="Admin" asp-action="DeleteWarehouse" style="display:inline">
                                        <input type="hidden" name="id" value="@w.WarehouseId" />
                                        <button class="btn btn-sm btn-danger">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                            }
                        }
                    </tbody>
                </table>
                <h6>Thêm kho hàng mới</h6>
                <form method="post" asp-controller="Admin" asp-action="AddWarehouse">
                    <div class="mb-2"><input name="code" placeholder="Mã kho (ví dụ: WH-01)" class="form-control" /></div>
                    <div class="mb-2"><input name="name" placeholder="Tên kho" class="form-control" /></div>
                    <div class="mb-2">
                        <select name="type" class="form-select">
                            <option value="MAIN">Kho chính (MAIN)</option>
                            <option value="DAMAGED">Kho hàng lỗi (DAMAGED)</option>
                            <option value="QC">Kho kiểm định (QC)</option>
                        </select>
                    </div>
                    <div class="mb-2"><input name="location" placeholder="Vị trí kho" class="form-control" /></div>
                    <div class="mb-2"><input name="capacity" placeholder="Sức chứa CBM (numeric)" type="number" step="0.01" class="form-control" /></div>
                    <button class="btn btn-sm btn-success">Thêm kho</button>
                </form>
            </div>
        </div>
    </form>
</div>
