@model List<DuAnCode.Web.Models.ViewModels.AdminUserViewModel>
@{
    ViewData["Title"] = "Quản lý Người dùng";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between mb-3">
        <h3>Danh sách người dùng</h3>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addUserModal">Thêm người dùng</button>
    </div>

    
    

    <table class="table table-striped">
        <thead><tr><th>Tên đăng nhập</th><th>Email</th><th>Phân quyền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody>
            @foreach(var u in Model ?? new List<DuAnCode.Web.Models.ViewModels.AdminUserViewModel>()){
                <tr>
                    <td>@u.UserName</td>
                    <td>@u.Email</td>
                    <td>
                        <form method="post" asp-controller="Admin" asp-action="ChangeRoleAjax" class="d-inline changeRoleForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@u.Id" />
                            <select name="role" class="form-select form-select-sm d-inline" style="width:160px;display:inline-block">
                                @{
                                    var totalUsers = ViewBag.TotalUsers as int? ?? 0;
                                }
                                @foreach(var r in ViewBag.AvailableRoles as List<string> ?? DuAnCode.Web.Services.RoleHelper.AllVietnameseRoles){
                                    var isSel = (u.Roles?.Contains(r) == true) || (u.Roles?.Contains(DuAnCode.Web.Services.RoleHelper.ToEnglish(r)) == true) || (u.Roles?.Contains(DuAnCode.Web.Services.RoleHelper.ToVietnamese(r)) == true);
                                    <option value="@r" selected="@isSel" disabled="@(totalUsers == 1)">@DuAnCode.Web.Services.RoleHelper.ToVietnamese(r)</option>
                                }
                            </select>
                            <button type="button" class="btn btn-sm btn-outline-primary btn-save-role">Lưu</button>
                        </form>
                    </td>
                    <td>
                        @if (u.IsLockedOut)
                        {
                            <span class="badge bg-danger">Bị khóa</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Hoạt động</span>
                        }
                    </td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Thao tác">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#profileModal_@u.Id">
                                        <i class="fa-solid fa-id-card text-info me-2"></i>Xem hồ sơ
                                    </button>
                                </li>
                                <li>
                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#resetModal_@u.Id">
                                        <i class="fa-solid fa-key text-secondary me-2"></i>Đổi mật khẩu
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" asp-controller="Admin" asp-action="ToggleLock" class="d-block">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="dropdown-item">
                                            @if (u.IsLockedOut)
                                            {
                                                <i class="fa-solid fa-unlock text-success me-2"></i><span>Mở khóa</span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-lock text-warning me-2"></i><span>Khóa tài khoản</span>
                                            }
                                        </button>
                                    </form>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                @{ var totalUsers = ViewBag.TotalUsers as int? ?? 0; }
                                @if(totalUsers > 1){
                                <li>
                                    <form class="deleteUserForm d-block">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="dropdown-item text-danger btn-delete-user" data-userid="@u.Id">
                                            <i class="fa-solid fa-trash me-2"></i>Xóa tài khoản
                                        </button>
                                    </form>
                                </li>
                                } else {
                                <li>
                                    <button class="dropdown-item text-muted" disabled>
                                        <i class="fa-solid fa-trash me-2"></i>Xóa (Vô hiệu)
                                    </button>
                                </li>
                                }
                            </ul>
                        </div>
                    </td>
                </tr>

                <div class="modal fade" id="profileModal_@u.Id" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header bg-info text-white"><h5 class="modal-title">Hồ sơ người dùng - @u.UserName</h5></div>
                            <div class="modal-body">
                                <p><strong>Họ và tên:</strong> @(string.IsNullOrEmpty(u.FullName) ? "(Chưa cập nhật)" : u.FullName)</p>
                                <p><strong>Email:</strong> @u.Email</p>
                                <p><strong>Số điện thoại:</strong> @(string.IsNullOrEmpty(u.PhoneNumber) ? "(Chưa cập nhật)" : u.PhoneNumber)</p>
                                <p><strong>Phân quyền:</strong> @u.Roles</p>
                                <p><strong>Trạng thái:</strong> @(u.IsLockedOut ? "Bị khóa" : "Hoạt động")</p>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="resetModal_@u.Id" tabindex="-1">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form method="post" asp-controller="Admin" asp-action="ResetPassword">
                                @Html.AntiForgeryToken()
                                <div class="modal-header"><h5 class="modal-title">Đặt lại mật khẩu - @u.UserName</h5></div>
                                <div class="modal-body">
                                    <input type="hidden" name="userId" value="@u.Id" />
                                    <div class="mb-2"><label>Mật khẩu mới</label><input name="newPassword" type="password" class="form-control" required minlength="6" /></div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                    <button type="submit" class="btn btn-primary">Lưu mật khẩu</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </tbody>
    </table>

    <!-- Add User Modal -->
    <div class="modal fade" id="addUserModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="createUserForm" method="post" asp-controller="Admin" asp-action="CreateUserAjax">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-primary text-white"><h5 class="modal-title"><i class="fa-solid fa-user-plus me-2"></i>Thêm người dùng mới</h5></div>
                    <div class="modal-body">
                        <div class="mb-2"><label class="form-label fw-semibold">Tên đăng nhập (Username)</label><input name="userName" class="form-control" placeholder="Tên đăng nhập..." required /></div>
                        <div class="mb-2"><label class="form-label fw-semibold">Họ và tên</label><input name="fullName" class="form-control" placeholder="Họ và tên đầy đủ..." /></div>
                        <div class="mb-2"><label class="form-label fw-semibold">Email</label><input name="email" type="email" class="form-control" placeholder="email@company.com" required /></div>
                        <div class="mb-2"><label class="form-label fw-semibold">Mật khẩu</label><input name="password" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự..." required minlength="6" /></div>
                        <div class="mb-2"><label class="form-label fw-semibold">Vai trò (Phân quyền)</label>
                            <select name="role" class="form-select">
                                @foreach(var r in ViewBag.AvailableRoles as List<string> ?? DuAnCode.Web.Services.RoleHelper.AllVietnameseRoles){
                                    <option value="@r">@DuAnCode.Web.Services.RoleHelper.ToVietnamese(r)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i>Tạo người dùng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Confirm replace admin modal -->
<div class="modal fade" id="confirmAdminModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Xác nhận thay đổi Admin</h5></div>
            <div class="modal-body">
                <p id="confirmAdminMessage">Hệ thống sẽ thay đổi Admin. Bạn có chắc?</p>
            </div>
            <div class="modal-footer">
                <button id="confirmAdminCancel" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button id="confirmAdminOk" class="btn btn-danger">Đồng ý chuyển quyền</button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function(){
    const createForm = document.getElementById('createUserForm');
    let pendingCreate = null;
    const confirmModalEl = document.getElementById('confirmAdminModal');
    const confirmModal = new bootstrap.Modal(confirmModalEl);
    const confirmMsg = document.getElementById('confirmAdminMessage');
    const confirmOk = document.getElementById('confirmAdminOk');

    createForm.addEventListener('submit', async function(e){
        e.preventDefault();
        const fd = new FormData(createForm);
        // send
        const resp = await fetch(createForm.action, { method: 'POST', body: fd, credentials: 'same-origin' });
        const data = await resp.json();
        if(!data) return;
        if(data.success){
            if(data.logout && data.redirect){ window.location = data.redirect; return; }
            location.reload();
            return;
        }
        if(data.requiresConfirmation){
            // show confirm modal and store pending form data
            pendingCreate = fd;
            confirmMsg.textContent = data.message || 'Xác nhận thay thế Admin cũ?';
            confirmModal.show();
            return;
        }
        // show error via top-right toast
        window.showToast(data.message || 'Lỗi khi tạo người dùng!', 'error');
    });

    confirmOk.addEventListener('click', async function(){
        if(!pendingCreate) return;
        pendingCreate.set('confirm', 'true');
        const resp = await fetch(createForm.action, { method: 'POST', body: pendingCreate, credentials: 'same-origin' });
        const data = await resp.json();
        pendingCreate = null;
        confirmModal.hide();
        if(data.success){ if(data.logout && data.redirect){ window.location = data.redirect; return; } location.reload(); }
        else { window.showToast(data.message || 'Thao tác thất bại!', 'error'); }
    });

    // role change via AJAX using explicit button clicks to avoid default navigation
    document.querySelectorAll('.btn-save-role').forEach(btn=>{
        btn.addEventListener('click', async function(e){
            e.preventDefault();
            const form = btn.closest('.changeRoleForm');
            if(!form) return;
            try{
                const tokenEl = form.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenEl ? tokenEl.value : '';
                const userIdEl = form.querySelector('input[name="userId"]');
                const userId = userIdEl ? userIdEl.value : '';
                const roleSel = form.querySelector('select[name="role"]');
                const newRole = roleSel ? roleSel.value : '';

                const params = new URLSearchParams();
                params.append('__RequestVerificationToken', token);
                params.append('userId', userId);
                params.append('role', newRole);

                const resp = await fetch('/Admin/ChangeRoleAjax', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: params.toString(),
                    credentials: 'same-origin'
                });
                const data = await resp.json();
                if(!data) return;
                if(data.success){
                    if(data.redirect){ window.location.href = data.redirect; return; }
                    try{ bootstrap.Modal.getInstance(confirmModalEl)?.hide(); } catch {}
                    window.showToast(data.message || 'Đã cập nhật quyền thành công!', 'success');
                    setTimeout(() => location.reload(), 1000);
                    return;
                }

                if(data.requiresConfirmation){
                    pendingCreate = { form: form, params: params };
                    confirmMsg.textContent = data.message || 'Xác nhận thay thế Admin cũ?';
                    confirmModal.show();
                    const onceHandler = async function(){
                        try{
                            params.set('confirm', 'true');
                            const r = await fetch('/Admin/ChangeRoleAjax', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: params.toString(), credentials: 'same-origin' });
                            const dd = await r.json();
                            confirmModal.hide();
                            confirmOk.onclick = null;
                            if(dd.success){ if(dd.redirect){ window.location.href = dd.redirect; return; } location.reload(); }
                            else window.showToast(dd.message || 'Lỗi cập nhật quyền!', 'error');
                        } catch(err){ console.error(err); window.showToast('Lỗi cập nhật quyền!', 'error'); }
                    };
                    confirmOk.onclick = onceHandler;
                    return;
                }

                window.showToast(data.message || 'Lỗi khi cập nhật quyền!', 'error');
            } catch(err){ console.error(err); window.showToast('Đã xảy ra lỗi kết nối!', 'error'); }
        });
    });

    // delete buttons
    document.querySelectorAll('.btn-delete-user').forEach(btn=>{
        btn.addEventListener('click', async function(e){
            e.preventDefault();
            const userId = this.dataset.userid;
            const token = this.dataset.token;
            if(!confirm('Are you sure to delete this user?')) return;
            const fd = new FormData(); fd.append('userId', userId); fd.append('__RequestVerificationToken', token);
            const resp = await fetch('/Admin/DeleteUserAjax', { method: 'POST', body: fd, credentials: 'same-origin' });
            const data = await resp.json();
            if(data.success){ location.reload(); } else { window.showToast(data.message || 'Lỗi khi xóa người dùng!', 'error'); }
        });
    });
});
</script>


