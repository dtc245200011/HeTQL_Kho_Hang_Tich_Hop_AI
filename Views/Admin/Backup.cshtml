@{
    ViewData["Title"] = "Sao lưu & Phục hồi dữ liệu";
}

<div class="container-fluid px-4 py-3">
    <!-- Header Page -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                <i class="fa-solid fa-database text-primary"></i> Sao lưu &amp; Phục hồi hệ thống
            </h3>
            <p class="text-muted small mb-0">Quản lý các bản sao lưu dữ liệu toàn diện (JSON/Snapshot) và khôi phục an toàn cho DuAnCode WMS.</p>
        </div>
        <div>
            <form method="post" asp-controller="Admin" asp-action="CreateBackup" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary px-3 shadow-sm">
                    <i class="fa-solid fa-cloud-arrow-down me-1"></i> Tạo bản sao lưu ngay
                </button>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột trái: Danh sách các bản sao lưu hiện có -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title fw-bold text-secondary mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-clock-rotate-left text-info"></i> Các bản sao lưu trên máy chủ
                    </h5>
                    <span class="badge bg-secondary rounded-pill">@( ((IEnumerable<dynamic>?)ViewBag.Backups)?.Count() ?? 0 ) bản lưu</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên tệp sao lưu</th>
                                    <th>Dung lượng</th>
                                    <th>Thời gian tạo</th>
                                    <th class="text-end pe-3">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (ViewBag.Backups != null && ((IEnumerable<dynamic>)ViewBag.Backups).Any())
                            {
                                foreach (var b in ViewBag.Backups)
                                {
                                    var sizeBytes = (long?)b.Size ?? 0L;
                                    var sizeFormatted = sizeBytes >= 1024 * 1024
                                        ? $"{(sizeBytes / (1024.0 * 1024.0)):F2} MB"
                                        : $"{(sizeBytes / 1024.0):F1} KB";
                                    var timeUtc = (DateTime)b.Time;
                                    var timeLocal = timeUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");

                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <i class="fa-solid fa-file-code text-warning fs-5 me-2"></i>
                                                <span class="fw-semibold text-dark">@b.Name</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border">@sizeFormatted</span>
                                        </td>
                                        <td class="small text-muted">@timeLocal</td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-success btn-select-inline" data-name="@b.Name" title="Chọn file này để khôi phục">
                                                    <i class="fa-solid fa-arrow-right-to-bracket"></i> Chọn
                                                </button>
                                                <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="DownloadBackup" asp-route-name="@b.Name" title="Tải về máy">
                                                    <i class="fa-solid fa-download"></i>
                                                </a>
                                                <form method="post" asp-controller="Admin" asp-action="DeleteBackup" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa vĩnh viễn bản sao lưu @b.Name này không?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="name" value="@b.Name" />
                                                    <button type="submit" class="btn btn-outline-danger" title="Xóa bản sao lưu">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        <i class="fa-solid fa-folder-open fs-2 mb-2 d-block text-secondary opacity-50"></i>
                                        Chưa có bản sao lưu nào trên máy chủ. Bấm <strong>"Tạo bản sao lưu ngay"</strong> để tạo bản đầu tiên.
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột phải: Phục hồi dữ liệu -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold text-danger mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-rotate-left text-warning"></i> Khôi phục dữ liệu (Restore)
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning d-flex align-items-start gap-2 py-2 px-3 small mb-3">
                        <i class="fa-solid fa-triangle-exclamation fs-5 mt-1 text-warning"></i>
                        <div>
                            <strong>Lưu ý quan trọng:</strong> Khôi phục dữ liệu sẽ đồng bộ hóa cơ sở dữ liệu về đúng thời điểm sao lưu. Hệ thống tự động snapshot dữ liệu hiện tại trước khi thực hiện để đảm bảo an toàn tuyệt đối.
                        </div>
                    </div>

                    <form id="restoreForm" method="post" asp-controller="Admin" asp-action="RestoreBackup" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="fileName" id="fileNameInput" />

                        <!-- Tùy chọn 1: Chọn từ file trên server -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary">Cách 1: Chọn bản sao lưu có sẵn trên máy chủ</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-server"></i></span>
                                <input type="text" id="selectedBackupDisplay" class="form-control" placeholder="Chưa chọn file sao lưu" readonly />
                                <button class="btn btn-outline-secondary" type="button" id="btnChooseBackup">
                                    <i class="fa-solid fa-list-check me-1"></i> Danh sách
                                </button>
                            </div>
                        </div>

                        <!-- Hoặc đường kẻ ngang phân tách -->
                        <div class="position-relative text-center my-3">
                            <hr class="text-muted" />
                            <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 small text-muted text-uppercase fw-bold" style="font-size: 0.75rem;">hoặc</span>
                        </div>

                        <!-- Tùy chọn 2: Tải lên file từ máy tính -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold small text-secondary" for="externalBackupFile">
                                Cách 2: Tải lên file sao lưu từ máy tính (.json, .enc)
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-upload"></i></span>
                                <input type="file" name="externalBackupFile" id="externalBackupFile" accept=".json,.enc" class="form-control" />
                            </div>
                            <div class="form-text small text-muted">Hỗ trợ các file định dạng JSON chuẩn xuất từ hệ thống DuAnCode WMS.</div>
                        </div>

                        <!-- Nút Khôi phục -->
                        <div class="d-grid">
                            <button type="button" id="btnRestore" class="btn btn-warning py-2 fw-semibold shadow-sm">
                                <i class="fa-solid fa-arrow-rotate-left me-1"></i> Bắt đầu Khôi phục dữ liệu
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Card hướng dẫn và an toàn -->
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h6 class="fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-shield-halved text-success"></i> Cơ chế Bảo vệ &amp; Toàn vẹn Dữ liệu
                    </h6>
                    <ul class="small text-muted mb-0 ps-3">
                        <li class="mb-1"><strong>Sao lưu toàn diện:</strong> Tự động đóng gói Users, Roles, Danh mục kho, Nhà cung cấp, Tồn kho, Phiếu nhập/xuất, Kiểm kê và Nhật ký hoạt động.</li>
                        <li class="mb-1"><strong>Khôi phục chống vỡ quan hệ (FK):</strong> Tự động xử lý thứ tự xóa và nạp khóa ngoại, đảm bảo liên kết dữ liệu luôn chuẩn xác.</li>
                        <li><strong>Tự động khôi phục sự cố:</strong> Nếu tệp sao lưu bị lỗi cấu trúc, hệ thống tự động Rollback về trạng thái ban đầu mà không làm gián đoạn vận hành.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Chọn file backup từ danh sách -->
<div class="modal fade" id="modalSelectBackup" tabindex="-1" aria-labelledby="modalSelectBackupLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="modalSelectBackupLabel">
                    <i class="fa-solid fa-file-lines text-primary me-2"></i>Chọn file sao lưu trên máy chủ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Tên file</th>
                                <th>Dung lượng</th>
                                <th>Thời gian tạo</th>
                                <th class="text-end pe-3">Chọn</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (ViewBag.Backups != null && ((IEnumerable<dynamic>)ViewBag.Backups).Any())
                        {
                            foreach (var b in ViewBag.Backups)
                            {
                                var sizeBytes = (long?)b.Size ?? 0L;
                                var sizeFormatted = sizeBytes >= 1024 * 1024
                                    ? $"{(sizeBytes / (1024.0 * 1024.0)):F2} MB"
                                    : $"{(sizeBytes / 1024.0):F1} KB";
                                var timeUtc = (DateTime)b.Time;
                                var timeLocal = timeUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");

                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@b.Name</div>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@sizeFormatted</span></td>
                                    <td class="small text-muted">@timeLocal</td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-sm btn-primary btn-select-backup" data-name="@b.Name">
                                            <i class="fa-solid fa-check me-1"></i> Chọn
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">Chưa có bản sao lưu nào trên máy chủ.</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Xác nhận cảnh báo trước khi Restore -->
<div class="modal fade" id="modalConfirmRestore" tabindex="-1" aria-labelledby="modalConfirmRestoreLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="modalConfirmRestoreLabel">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>CẢNH BÁO XÁC NHẬN KHÔI PHỤC
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-3">
                    <i class="fa-solid fa-circle-exclamation text-danger fs-1"></i>
                </div>
                <p class="fw-bold text-danger text-center fs-6 mb-2">
                    Toàn bộ dữ liệu hiện tại trong cơ sở dữ liệu sẽ được thay thế bằng dữ liệu từ bản sao lưu được chọn!
                </p>
                <p class="small text-muted text-center mb-0">
                    Để đảm bảo an toàn cao nhất, bạn nên chọn <strong>"Tạo sao lưu mới &amp; Tiếp tục"</strong> để lưu lại toàn bộ dữ liệu hiện tại trước khi ghi đè.
                </p>
            </div>
            <div class="modal-footer bg-light flex-column gap-2 p-3">
                <button id="btnCreateBackupThenRestore" type="button" class="btn btn-primary w-100 py-2">
                    <i class="fa-solid fa-shield-check me-1"></i> Tạo bản sao lưu an toàn &amp; Tiếp tục Khôi phục
                </button>
                <div class="d-flex w-100 gap-2">
                    <button id="btnConfirmRestore" type="button" class="btn btn-outline-danger flex-grow-1">
                        Khôi phục ngay (Bỏ qua sao lưu)
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const modalSelectEl = document.getElementById('modalSelectBackup');
    const modalSelect = modalSelectEl ? new bootstrap.Modal(modalSelectEl) : null;

    const confirmModalEl = document.getElementById('modalConfirmRestore');
    const confirmModal = confirmModalEl ? new bootstrap.Modal(confirmModalEl) : null;

    // Nút mở modal chọn backup
    document.getElementById('btnChooseBackup')?.addEventListener('click', function (e) {
        e.preventDefault();
        modalSelect?.show();
    });

    // Khi chọn 1 file từ modal hoặc từ bảng bên trái
    function selectBackupFile(name) {
        const display = document.getElementById('selectedBackupDisplay');
        const fileInput = document.getElementById('fileNameInput');
        const uploadInput = document.getElementById('externalBackupFile');
        if (display) display.value = name;
        if (fileInput) fileInput.value = name;
        if (uploadInput) uploadInput.value = ''; // xóa file upload nếu đã chọn từ server
        modalSelect?.hide();
    }

    document.querySelectorAll('.btn-select-backup').forEach(btn => {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            const name = this.getAttribute('data-name') || '';
            selectBackupFile(name);
        });
    });

    document.querySelectorAll('.btn-select-inline').forEach(btn => {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            const name = this.getAttribute('data-name') || '';
            selectBackupFile(name);
        });
    });

    // Khi người dùng chọn upload file từ máy tính
    document.getElementById('externalBackupFile')?.addEventListener('change', function () {
        if (this.files && this.files.length > 0) {
            const display = document.getElementById('selectedBackupDisplay');
            const fileInput = document.getElementById('fileNameInput');
            if (display) display.value = `[File máy tính]: ${this.files[0].name}`;
            if (fileInput) fileInput.value = ''; // xóa file server để ưu tiên file upload
        }
    });

    // Bấm nút Restore -> Kiểm tra điều kiện & Hiện modal cảnh báo
    document.getElementById('btnRestore')?.addEventListener('click', function (e) {
        e.preventDefault();
        const serverFile = document.getElementById('fileNameInput')?.value?.trim();
        const uploadFile = document.getElementById('externalBackupFile')?.files;

        if (!serverFile && (!uploadFile || uploadFile.length === 0)) {
            window.showToast('Vui lòng chọn 1 bản sao lưu từ máy chủ hoặc tải lên 1 tệp sao lưu từ máy tính!', 'warning');
            return;
        }

        confirmModal?.show();
    });

    // Xác nhận khôi phục trực tiếp
    document.getElementById('btnConfirmRestore')?.addEventListener('click', function (e) {
        e.preventDefault();
        confirmModal?.hide();
        document.getElementById('restoreForm')?.submit();
    });

    // Tạo bản sao lưu an toàn rồi mới khôi phục
    document.getElementById('btnCreateBackupThenRestore')?.addEventListener('click', async function (e) {
        e.preventDefault();
        const originalText = this.innerHTML;
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo sao lưu dự phòng...';

        try {
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            const headers = {};
            if (tokenEl) headers['RequestVerificationToken'] = tokenEl.value;

            const res = await fetch('@Url.Action("CreateBackupAjax", "Admin")', {
                method: 'POST',
                headers: headers
            });
            const j = await res.json();
            if (j?.success) {
                confirmModal?.hide();
                document.getElementById('restoreForm')?.submit();
            } else {
                window.showToast('Tạo sao lưu dự phòng thất bại: ' + (j?.error || 'Không rõ nguyên nhân') + '. Hủy bỏ khôi phục để bảo vệ dữ liệu.', 'error');
                this.disabled = false;
                this.innerHTML = originalText;
            }
        } catch (err) {
            console.error(err);
            window.showToast('Lỗi kết nối khi gửi yêu cầu sao lưu dự phòng.', 'error');
            this.disabled = false;
            this.innerHTML = originalText;
        }
    });
});
</script>
