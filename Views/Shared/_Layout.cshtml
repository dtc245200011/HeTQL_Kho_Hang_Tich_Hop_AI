                </div>
            </div>
            <button id="openChatBtn" class="btn btn-primary btn-lg rounded-circle shadow btn-icon-only" style="width: 58px; height: 58px; float: right;" data-tooltip="Trợ lý AI Ollama - Hỏi đáp và hỗ trợ tra cứu thông tin kho" data-tt-type="func">
                <i class="fa-solid fa-message fs-4"></i>
