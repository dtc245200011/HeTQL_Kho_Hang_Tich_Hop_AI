    {
        <!-- AI Chat Widget -->
        <div id="aiChatWidget" class="position-fixed" style="bottom: 20px; right: 20px; z-index: 1050;">
            <div id="chatBox" class="card shadow d-none" style="width: 360px; height: 460px;">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                    <h6 class="mb-0 fs-6"><i class="fa-solid fa-robot me-1"></i> Trợ lý AI WMS</h6>
