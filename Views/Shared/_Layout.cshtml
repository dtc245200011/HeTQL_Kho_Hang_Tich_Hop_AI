@using DuAnCode.Web.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    string userDisplay = User.Identity?.Name ?? "Khách";
    IList<string> roles = new List<string>();
    if (isAuthenticated)
    {
        var currentUser = await UserManager.GetUserAsync(User);
            if (currentUser != null)
            {
                userDisplay = string.IsNullOrWhiteSpace(currentUser.FullName) ? (currentUser.UserName ?? User.Identity?.Name ?? "Khách") : currentUser.FullName;
                roles = await UserManager.GetRolesAsync(currentUser);
            }
    }

    bool isAdmin = roles.Contains("Admin") || roles.Contains("Director");
    bool isWarehouse = roles.Contains("WarehouseManager") || roles.Contains("WarehouseKeeper");
    bool isAccountant = roles.Contains("Accountant");
    bool isQc = roles.Contains("QC");
    bool isStaff = roles.Contains("Staff");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DuAnCode WMS</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/css/site.css" />

    <style>
        /* Sidebar layout */
        .app-root { display: flex; height: 100vh; }
        .sidebar {
            width: 250px;
            background: #0d6efd; /* bootstrap primary */
            color: #fff;
            display: flex;
            flex-direction: column;
            transition: width 0.2s ease;
            min-width: 70px;
        }
        .sidebar .sidebar-header { padding: 1rem; display:flex; align-items:center; gap:.5rem; }
        .sidebar .brand { font-weight:700; font-size:1rem; }
        .sidebar .profile { padding: 0.75rem 1rem; border-top:1px solid rgba(255,255,255,0.06); border-bottom:1px solid rgba(255,255,255,0.06); }
        .sidebar .profile .avatar { width:42px; height:42px; border-radius:50%; background:#fff3; display:inline-flex; align-items:center; justify-content:center; }
        .sidebar .nav-links { padding: .5rem 0; flex:1; overflow:auto; }
        .sidebar .nav-link { color: #e9f2ff; padding: .6rem 1rem; display:flex; align-items:center; gap:.6rem; text-decoration:none; }
        .sidebar .nav-link:hover { background: rgba(255,255,255,0.06); color: #fff; }
        .sidebar .logout { margin: 1rem; }

        .main-content { flex:1; overflow:auto; display:flex; flex-direction:column; }
        .main-header { padding: .75rem 1rem; border-bottom:1px solid #e9ecef; background:#f8f9fa; }
        .main-body { padding:1rem; }

        .sidebar-collapsed { width: 70px !important; }
        .sidebar-collapsed .brand, .sidebar-collapsed .profile .meta, .sidebar-collapsed .nav-link span.text { display:none; }
        .sidebar-collapsed .nav-link { justify-content:center; }

        @@media (max-width: 768px) {
            .sidebar { position: fixed; left: -260px; top:0; bottom:0; z-index:1045; }
            .sidebar.show { left:0; }
            .main-content { margin-left:0; }
        }
    </style>

    <script>
        // Sidebar toggle script will run after DOM loaded
        function initSidebar() {
            const root = document.documentElement;
            const sidebar = document.querySelector('.sidebar');
            const toggle = document.getElementById('sidebarToggle');
            const collapsed = localStorage.getItem('sidebarCollapsed') === '1';
            if (collapsed) sidebar.classList.add('sidebar-collapsed');

            toggle?.addEventListener('click', function (e) {
                e.preventDefault();
                if (window.innerWidth <= 768) {
                    // mobile: show/hide
                    sidebar.classList.toggle('show');
                } else {
                    sidebar.classList.toggle('sidebar-collapsed');
                    localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('sidebar-collapsed') ? '1' : '0');
                }
            });

            // close sidebar when clicking outside on mobile
            document.addEventListener('click', function(e) {
                if (window.innerWidth <= 768) {
                    if (!sidebar.contains(e.target) && !document.getElementById('sidebarToggle')?.contains(e.target)) {
                        sidebar.classList.remove('show');
                    }
                }
            });
        }
        document.addEventListener('DOMContentLoaded', initSidebar);
    </script>

    <script src="/js/site.js" defer></script>
</head>
<body>
    <div class="app-root">
        <aside class="sidebar" role="complementary">
            <div class="sidebar-header">
                <button id="sidebarToggle" class="btn btn-sm btn-light" title="Toggle sidebar"><i class="fa fa-bars"></i></button>
                <a asp-controller="Dashboard" asp-action="Index" class="brand text-white ms-2">DuAnCode WMS</a>
            </div>

            <div class="profile d-flex align-items-center">
                <div class="avatar me-2"><i class="fa fa-user"></i></div>
                <div class="meta">
                    <div class="fw-bold">@userDisplay</div>
                    <div class="small text-white-50">@string.Join(", ", roles)</div>
                </div>
            </div>

            <nav class="nav-links">
                <a asp-controller="Dashboard" asp-action="Index" class="nav-link"><i class="fa-solid fa-chart-pie"></i> <span class="text">Tổng quan</span></a>
                @if (isAdmin || isWarehouse || isStaff || isQc || isAccountant)
                {
                    <a asp-controller="Inbound" asp-action="Index" class="nav-link"><i class="fa-solid fa-box-arrow-in-down"></i> <span class="text">Nhập kho</span></a>
                    <a asp-controller="Outbound" asp-action="Index" class="nav-link"><i class="fa-solid fa-box-arrow-up"></i> <span class="text">Xuất kho</span></a>
                }
                @if (isAdmin || isWarehouse)
                {
                    <a asp-controller="Replenishment" asp-action="Index" class="nav-link"><i class="fa-solid fa-robot"></i> <span class="text">Gợi ý AI</span></a>
                }
                @if (isAdmin || isAccountant || isWarehouse)
                {
                    <a asp-controller="Report" asp-action="Index" class="nav-link"><i class="fa-solid fa-file-chart-line"></i> <span class="text">Báo cáo</span></a>
                }
                @if (isAdmin)
                {
                    <a asp-controller="Admin" asp-action="Index" class="nav-link"><i class="fa-solid fa-gear"></i> <span class="text">Quản lý Hệ thống</span></a>
                }
                @if (isQc)
                {
                    <a asp-controller="Quality" asp-action="Index" class="nav-link"><i class="fa-solid fa-magnifying-glass"></i> <span class="text">QC Hàng hỏng</span></a>
                }
            </nav>

            <div class="logout mt-auto">
                @if (!isAuthenticated)
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light w-100">Đăng nhập</a>
                }
                else
                {
                    <form asp-controller="Account" asp-action="LogoutPost" method="post">@Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger w-100">Đăng xuất</button>
                    </form>
                }
            </div>
        </aside>

        <div class="main-content">
            <header class="main-header d-flex justify-content-between align-items-center">
                <div class="ms-3">@ViewData["Title"]</div>
                <div class="me-3 small text-muted">@userDisplay</div>
            </header>

            <div class="main-body">
                @RenderBody()
            </div>

            <footer class="mt-auto py-3 bg-light">
                <div class="container text-center small">© DuAnCode 2026 • Warehouse Management</div>
            </footer>
        </div>
    </div>

</body>
</html>
