    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        // Global override for window.alert - redirects all legacy alert() calls to top-right toast
        window.alert = function(msg) {
            window.showToast(msg, 'warning');
        };

        // Global showToast function - places notifications in top-right corner
        window.showToast = function(message, type = 'success', title = null, duration = 5000) {
            let container = document.getElementById('toastNotificationContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'toastNotificationContainer';
                container.className = 'toast-container position-fixed top-0 end-0 p-3';
                container.style.cssText = 'z-index: 99999; pointer-events: none; max-width: 420px; width: 100%;';
                document.body.appendChild(container);
            }

            const icons = {
                success: 'fa-circle-check',
                error: 'fa-circle-exclamation',
                danger: 'fa-circle-exclamation',
                warning: 'fa-triangle-exclamation',
                info: 'fa-circle-info'
            };
            const defaultTitles = {
                success: 'Thành công',
                error: 'Thông báo Lỗi',
                danger: 'Thông báo Lỗi',
                warning: 'Cảnh báo',
                info: 'Thông tin'
            };
            const bgClasses = {
                success: 'bg-success text-white',
                error: 'bg-danger text-white',
                danger: 'bg-danger text-white',
                warning: 'bg-warning text-dark',
                info: 'bg-info text-white'
            };
            const progressBgs = {
                success: 'bg-success',
                error: 'bg-danger',
                danger: 'bg-danger',
                warning: 'bg-warning',
                info: 'bg-info'
            };

            const toastType = (type === 'error') ? 'danger' : type;
            const toastTitle = title || defaultTitles[type] || 'Thông báo';
            const icon = icons[type] || 'fa-bell';
            const bg = bgClasses[toastType] || 'bg-primary text-white';
            const pBg = progressBgs[toastType] || 'bg-primary';
            const closeBtnClass = (toastType === 'warning') ? 'btn-close' : 'btn-close btn-close-white';

            const toastEl = document.createElement('div');
            toastEl.className = 'toast custom-toast show shadow-lg border-0 mb-3';
            toastEl.style.pointerEvents = 'auto';
            toastEl.setAttribute('role', 'alert');
            toastEl.setAttribute('aria-live', 'assertive');
            toastEl.setAttribute('aria-atomic', 'true');

            toastEl.innerHTML = `
                <div class="toast-header ${bg} py-2">
                    <i class="fa-solid ${icon} me-2 fs-5"></i>
                    <strong class="me-auto">${toastTitle}</strong>
                    <small class="${toastType === 'warning' ? 'text-muted' : 'text-white-50'}">Vừa xong</small>
                    <button type="button" class="${closeBtnClass}" aria-label="Close"></button>
                </div>
                <div class="toast-body bg-white text-dark py-3 fw-medium">
                    ${message}
                </div>
                <div class="toast-progress ${pBg}" style="animation: toastProgress ${duration}ms linear forwards;"></div>
            `;

            container.appendChild(toastEl);

            // Add to dropdown notification center
            addNotificationToDropdown(toastTitle, message, type);

            const closeBtn = toastEl.querySelector('.btn-close');
            const dismiss = () => {
                toastEl.classList.add('toast-hiding');
                setTimeout(() => toastEl.remove(), 350);
            };

            if (closeBtn) closeBtn.onclick = dismiss;
            if (duration > 0) setTimeout(dismiss, duration);
        };

        function addNotificationToDropdown(title, message, type) {
            const list = document.getElementById('notifList');
            const badge = document.getElementById('notifBadge');
            const countText = document.getElementById('notifCountText');
            const emptyMsg = document.getElementById('emptyNotifMsg');
            if (!list) return;

            if (emptyMsg) emptyMsg.remove();
            if (badge) badge.classList.remove('d-none');

            const item = document.createElement('div');
            item.className = 'p-2 border-bottom hover-bg-light rounded mb-1';
            const colorClass = (type === 'error' || type === 'danger') ? 'text-danger' : (type === 'warning' ? 'text-warning' : 'text-success');
            const iconClass = (type === 'error' || type === 'danger') ? 'fa-circle-exclamation' : (type === 'warning' ? 'fa-triangle-exclamation' : 'fa-circle-check');
            item.innerHTML = `
                <div class="d-flex align-items-start">
                    <div class="${colorClass} me-2 mt-1"><i class="fa-solid ${iconClass}"></i></div>
                    <div class="flex-grow-1">
                        <div class="fw-semibold small ${colorClass}">${title}</div>
                        <div class="text-muted small">${message}</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Vừa xong</div>
                    </div>
                </div>
            `;
            list.prepend(item);

            const currentCount = list.querySelectorAll('.hover-bg-light').length;
            if (countText) countText.textContent = currentCount + ' mới';
        }

        function clearAllNotifications() {
            const list = document.getElementById('notifList');
            const badge = document.getElementById('notifBadge');
            const countText = document.getElementById('notifCountText');
            if (list) {
                list.innerHTML = `
                    <div class="text-center text-muted py-4 small" id="emptyNotifMsg">
                        <i class="fa-regular fa-bell-slash fs-3 d-block mb-2 opacity-50"></i>
                        Không có thông báo mới nào
                    </div>
                `;
            }
            if (badge) badge.classList.add('d-none');
            if (countText) countText.textContent = '0 mới';
        }

        // Auto-dismiss server-rendered toasts
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('#toastNotificationContainer .custom-toast').forEach(function(t) {
                const closeBtn = t.querySelector('.btn-close');
                const dismiss = () => {
                    t.classList.add('toast-hiding');
                    setTimeout(() => t.remove(), 350);
                };
                if (closeBtn) closeBtn.onclick = dismiss;
                setTimeout(dismiss, 5000);
            });
        });
    </script>
