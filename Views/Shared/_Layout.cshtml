        <script>
            document.addEventListener('DOMContentLoaded', function() {
                let intv = setInterval(function() {
                    if (window.jQuery) {
                        clearInterval(intv);
                        initChat();
                    }
                }, 100);

                function initChat() {
                    let currentUser = '@(User.Identity?.Name ?? "guest")';
                    let chatKey = 'chatHistory_' + currentUser;

                    // Allowed routes whitelist to prevent Open Redirect & DOM XSS
                    const ALLOWED_NAV_ROUTES = [
                        '/inbound', '/inbound/create',
                        '/outbound', '/outbound/create',
                        '/stocktransfer', '/stocktransfer/create',
                        '/inventoryaudit', '/inventoryaudit/create',
                        '/replenishment',
                        '/report', '/report/inventory', '/report/exportexcel',
                        '/admin', '/admin/users', '/admin/backup', '/admin/exportdata', '/admin/settings', '/admin/logs',
                        '/home', '/dashboard', '/aidashboard'
                    ];

                    function isSafeNavUrl(url) {
                        if (!url || typeof url !== 'string') return false;
                        let trimmed = url.trim();
                        // Reject protocols, protocol-relative, backslashes
                        if (!trimmed.startsWith('/') || trimmed.startsWith('//') || trimmed.includes('\\')) return false;
                        let path = trimmed.split('?')[0].split('#')[0].toLowerCase();
                        return ALLOWED_NAV_ROUTES.indexOf(path) !== -1;
                    }

                    function saveChat(role, content) {
                        let history = JSON.parse(localStorage.getItem(chatKey)) || [];
                        history.push({ role: role, content: content });
                        // Keep last 20 messages in storage
                        if (history.length > 20) history = history.slice(history.length - 20);
                        localStorage.setItem(chatKey, JSON.stringify(history));
                    }

                    function renderFormattedMessage(text) {
                        if (!text) return '';
                        let html = escapeHtml(text);
                        // Markdown bold: **text**
                        html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                        // Inline code: `code`
                        html = html.replace(/`([^`]+)`/g, '<code class="bg-light text-dark px-1 py-0.5 rounded border small">$1</code>');
                        // Markdown link: [text](url)
                        html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function(m, p1, p2) {
                            let trimmed = p2.trim();
                            if (trimmed.startsWith('/') || trimmed.startsWith('http://') || trimmed.startsWith('https://')) {
                                return '<a href="' + escapeHtml(trimmed) + '" class="text-primary fw-bold text-decoration-underline">' + p1 + ' <i class="fa-solid fa-arrow-up-right-from-square small"></i></a>';
                            }
                            return p1;
                        });
                        // Newlines
                        html = html.replace(/\n/g, '<br>');
                        return html;
                    }

                    function loadChat() {
                        let history = JSON.parse(localStorage.getItem(chatKey)) || [];
                        history.forEach(item => {
                            if (item.role === 'user') {
                                $('#chatMessages').append('<div class="d-flex justify-content-end mb-2"><div class="bg-primary text-white p-2 rounded" style="max-width: 80%; font-size: 0.9em;">' + escapeHtml(item.content) + '</div></div>');
                            } else {
                                let replyHtml = renderFormattedMessage(item.content);
                                $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-white border p-2 rounded shadow-sm" style="max-width: 85%; font-size: 0.9em;">' + replyHtml + '</div></div>');
                            }
                        });
                        scrollToBottom();
                    }
                    
                    loadChat();

                    $('#openChatBtn').click(function() {
                        $('#chatBox').removeClass('d-none').addClass('d-flex flex-column');
                        $(this).addClass('d-none');
                        $('#chatInput').focus();
                    });
                    $('#closeChat').click(function() {
                        $('#chatBox').addClass('d-none').removeClass('d-flex flex-column');
                        $('#openChatBtn').removeClass('d-none');
                    });

                    $('#clearChatHistory').click(function() {
                        if (confirm('Bạn có muốn xóa toàn bộ lịch sử cuộc trò chuyện này?')) {
                            localStorage.removeItem(chatKey);
                            $('#chatMessages').html('<div class="text-muted text-center small mb-3"><span class="badge bg-light text-secondary border"><i class="fa-solid fa-circle-check text-success me-1"></i>Trợ lý AI đã sẵn sàng</span></div>');
                        }
                    });

                    $('#chatForm').submit(function(e) {
                        e.preventDefault();
                        let prompt = $('#chatInput').val().trim();
                        if (!prompt) return;

                        // Display user message
                        $('#chatMessages').append('<div class="d-flex justify-content-end mb-2"><div class="bg-primary text-white p-2 rounded" style="max-width: 80%; font-size: 0.9em;">' + escapeHtml(prompt) + '</div></div>');
                        
                        // Collect history for multi-turn context (last 6 messages before this one)
                        let rawHistory = JSON.parse(localStorage.getItem(chatKey)) || [];
                        let historyPayload = rawHistory.slice(-6).map(function(item) {
                            return { role: item.role, content: item.content };
                        });

                        saveChat('user', prompt);
                        $('#chatInput').val('');
                        scrollToBottom();

                        let loadingId = 'loading-' + Date.now();
                        $('#chatMessages').append('<div id="' + loadingId + '" class="d-flex justify-content-start mb-2"><div class="bg-light border p-2 rounded text-muted small">AI đang suy nghĩ <i class="fa-solid fa-circle-notch fa-spin ms-1"></i></div></div>');
                        scrollToBottom();
                        $('#sendChatBtn').prop('disabled', true);

                        $.ajax({
                            url: '/api/AiChat/chat',
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ prompt: prompt, history: historyPayload }),
                            success: function(res) {
                                $('#' + loadingId).remove();
                                let replyText = res.reply || '';
                                
                                // Parse NAVIGATE command
                                let navMatch = replyText.match(/\[NAVIGATE:\s*([^\]]+)\]/);
                                let actionMatch = replyText.match(/\[ACTION:\s*([^\]]+)\]/);
                                
                                let navUrl = null;
                                if (navMatch) {
                                    navUrl = navMatch[1].trim();
                                    replyText = replyText.replace(navMatch[0], '').trim();
                                }
                                
                                let actionCmd = null;
                                let actionData = null;
                                if (actionMatch) {
                                    let fullAction = actionMatch[1].trim();
                                    replyText = replyText.replace(actionMatch[0], '').trim();
                                    
                                    if (fullAction.startsWith('CREATE_DRAFT_INBOUND:')) {
                                        actionCmd = 'CREATE_DRAFT_INBOUND';
                                        let jsonStr = fullAction.substring('CREATE_DRAFT_INBOUND:'.length).trim();
                                        try { actionData = JSON.parse(jsonStr); } catch(e) { console.warn('JSON parse error:', jsonStr); }
                                    } else if (fullAction.startsWith('CREATE_DRAFT_OUTBOUND:')) {
                                        actionCmd = 'CREATE_DRAFT_OUTBOUND';
                                        let jsonStr = fullAction.substring('CREATE_DRAFT_OUTBOUND:'.length).trim();
                                        try { actionData = JSON.parse(jsonStr); } catch(e) { console.warn('JSON parse error:', jsonStr); }
                                    } else {
                                        actionCmd = fullAction;
                                    }
                                }
                                
                                saveChat('ai', replyText);
                                let replyHtml = renderFormattedMessage(replyText);
                                $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-white border p-2 rounded shadow-sm" style="max-width: 85%; font-size: 0.9em;">' + replyHtml + '</div></div>');
                                scrollToBottom();
                                $('#sendChatBtn').prop('disabled', false);
                                $('#chatInput').focus();
                                
                                if (navUrl) {
                                    if (isSafeNavUrl(navUrl)) {
                                        let currentFull = window.location.pathname + window.location.search;
                                        let isSamePage = currentFull.toLowerCase() === navUrl.toLowerCase();
                                        if (!isSamePage) {
                                            $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-info bg-opacity-10 text-primary border border-info p-2 rounded small"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Đang chuyển hướng tới ' + escapeHtml(navUrl) + '...</div></div>');
                                            scrollToBottom();
                                            setTimeout(function() {
                                                window.location.href = navUrl;
                                            }, 1800);
                                        }
                                    } else {
                                        console.warn('Blocked untrusted navigation target:', navUrl);
                                        $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-warning text-dark border p-2 rounded small"><i class="fa-solid fa-shield-halved me-1"></i> Đã chặn chuyển hướng không an toàn (' + escapeHtml(navUrl) + ').</div></div>');
                                        scrollToBottom();
                                    }
                                }
                                
                                if (actionCmd === 'TRIGGER_REPLENISHMENT') {
                                    $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-warning text-dark border p-2 rounded small"><i class="fa fa-spinner fa-spin me-1"></i> Hệ thống đang chạy quét phân tích AI trên toàn bộ kho...</div></div>');
                                    scrollToBottom();
                                    $.post('/api/AiChat/trigger-replenishment')
                                        .done(function(res) {
                                            setTimeout(function() {
                                                $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-success text-white border p-2 rounded small"><i class="fa fa-check me-1"></i> ' + escapeHtml(res.message || 'Hoàn tất phân tích!') + ' Đang mở trang Đề xuất nhập...</div></div>');
                                                scrollToBottom();
                                                setTimeout(function() { window.location.href = '/Replenishment'; }, 1500);
                                            }, 1000);
                                        })
                                        .fail(function(xhr) {
                                            let err = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : xhr.responseText;
                                            $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-danger text-white border p-2 rounded small"><i class="fa fa-triangle-exclamation me-1"></i> ' + escapeHtml(err || 'Lỗi khi kích hoạt phân tích.') + '</div></div>');
                                            scrollToBottom();
                                        });
                                } else if (actionCmd === 'TRIGGER_BACKUP') {
                                    $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-warning text-dark border p-2 rounded small"><i class="fa fa-spinner fa-spin me-1"></i> Hệ thống đang trích xuất snapshot và khởi tạo bản sao lưu dữ liệu...</div></div>');
                                    scrollToBottom();
                                    $.post('/api/AiChat/trigger-backup')
                                        .done(function(res) {
                                            setTimeout(function() {
                                                let downloadUrl = '/Admin/DownloadBackup?name=' + encodeURIComponent(res.file);
                                                $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-success text-white border p-2 rounded small"><i class="fa fa-check me-1"></i> ' + escapeHtml(res.message || 'Đã tạo bản sao lưu thành công!') + '<br><div class="mt-2"><a href="' + downloadUrl + '" class="btn btn-sm btn-light text-dark fw-bold me-2"><i class="fa-solid fa-download me-1"></i>Tải file sao lưu</a><a href="/Admin/Backup" class="btn btn-sm btn-outline-light"><i class="fa-solid fa-database me-1"></i>Xem trang Backup</a></div></div></div>');
                                                scrollToBottom();
                                            }, 800);
                                        })
                                        .fail(function(xhr) {
                                            let err = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : xhr.responseText;
                                            $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-danger text-white border p-2 rounded small"><i class="fa fa-triangle-exclamation me-1"></i> ' + escapeHtml(err || 'Lỗi khi tạo bản sao lưu. Vui lòng kiểm tra quyền Admin.') + ' <a href="/Admin/Backup" class="text-white text-decoration-underline ms-1">Mở trang Backup</a></div></div>');
                                            scrollToBottom();
                                        });
                                } else if (actionCmd === 'CREATE_DRAFT_INBOUND' || actionCmd === 'CREATE_DRAFT_OUTBOUND') {
                                    let isOut = actionCmd === 'CREATE_DRAFT_OUTBOUND';
                                    let vType = isOut ? 'OUTBOUND' : 'INBOUND';
                                    let vTitle = isOut ? 'Phiếu Xuất kho' : 'Phiếu Nhập kho';
                                    let vPartner = (actionData && actionData.counterparty) ? actionData.counterparty : (isOut ? 'Khách hàng' : 'Nhà cung cấp');
                                    let vSku = (actionData && actionData.sku) ? actionData.sku : 'SKU-001';
                                    let vQty = (actionData && actionData.quantity) ? actionData.quantity : 10;
                                    let cardId = 'actionCard-' + Date.now();

                                    let cardHtml = `
                                        <div id="${cardId}" class="d-flex justify-content-start mb-2">
                                            <div class="card border-primary shadow-sm" style="max-width: 88%; font-size: 0.88em;">
                                                <div class="card-header bg-primary bg-opacity-10 text-primary py-1 px-2 fw-bold">
                                                    <i class="fa-solid fa-file-pen me-1"></i> Xác nhận tạo bản nháp ${vTitle}
                                                </div>
                                                <div class="card-body p-2">
                                                    <div><b>Đối tác:</b> ${escapeHtml(vPartner)}</div>
                                                    <div><b>Mặt hàng:</b> <code>${escapeHtml(vSku)}</code></div>
                                                    <div><b>Số lượng:</b> <span class="badge bg-secondary">${vQty}</span></div>
                                                    <div class="mt-2 pt-2 border-top d-flex gap-2">
                                                        <button class="btn btn-primary btn-sm py-0 px-2 confirm-btn"><i class="fa-solid fa-check me-1"></i>Tạo phiếu</button>
                                                        <button class="btn btn-outline-secondary btn-sm py-0 px-2 cancel-btn"><i class="fa-solid fa-xmark me-1"></i>Hủy</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    `;
                                    $('#chatMessages').append(cardHtml);
                                    scrollToBottom();

                                    let $card = $('#' + cardId);
                                    $card.find('.confirm-btn').click(function() {
                                        let $btn = $(this);
                                        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Đang tạo...');
                                        $card.find('.cancel-btn').remove();

                                        $.ajax({
                                            url: '/api/AiChat/create-draft-voucher',
                                            method: 'POST',
                                            contentType: 'application/json',
                                            data: JSON.stringify({
                                                type: vType,
                                                counterparty: vPartner,
                                                sku: vSku,
                                                quantity: parseInt(vQty) || 10
                                            }),
                                            success: function(r) {
                                                $card.find('.card-body').html(`
                                                    <div class="text-success fw-bold mb-1"><i class="fa fa-circle-check me-1"></i>${escapeHtml(r.message)}</div>
                                                    <div class="small text-muted mb-2">Số phiếu: <b>${escapeHtml(r.voucherNumber)}</b> (${escapeHtml(r.quantity)} đơn vị)</div>
                                                    <div class="d-flex gap-2">
                                                        <a href="${escapeHtml(r.directUrl || r.targetUrl)}" class="btn btn-primary btn-sm py-1 px-2"><i class="fa-solid fa-file-pen me-1"></i>Mở & Sửa phiếu ngay</a>
                                                        <a href="${escapeHtml(r.targetUrl)}" class="btn btn-outline-secondary btn-sm py-1 px-2"><i class="fa-solid fa-eye me-1"></i>Xem danh sách</a>
                                                    </div>
                                                `);
                                                scrollToBottom();
                                            },
                                            error: function(xhr) {
                                                let errTxt = xhr.status === 403 
                                                    ? 'Bạn không đủ quyền thực hiện (chỉ Quản lý kho / Giám đốc / Admin).' 
                                                    : (xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : xhr.responseText || 'Lỗi khi tạo phiếu.');
                                                $card.find('.card-body').html(`
                                                    <div class="text-danger small"><i class="fa-solid fa-triangle-exclamation me-1"></i>${escapeHtml(errTxt)}</div>
                                                `);
                                                scrollToBottom();
                                            }
                                        });
                                    });

                                    $card.find('.cancel-btn').click(function() {
                                        $card.find('.card-body').html('<div class="text-muted small fst-italic"><i class="fa-solid fa-ban me-1"></i>Đã hủy yêu cầu tạo phiếu.</div>');
                                    });
                                }
                            },
                            error: function(xhr) {
                                $('#' + loadingId).remove();
                                $('#chatMessages').append('<div class="d-flex justify-content-start mb-2"><div class="bg-danger text-white p-2 rounded small">Lỗi kết nối AI: ' + escapeHtml(xhr.responseText || 'Không thể kết nối máy chủ.') + '</div></div>');
                                scrollToBottom();
                                $('#sendChatBtn').prop('disabled', false);
                                $('#chatInput').focus();
                            }
                        });
                    });

                    function escapeHtml(text) {
                        return $('<div>').text(text).html();
                    }
                    function scrollToBottom() {
                        let d = $('#chatMessages');
                        d.scrollTop(d.prop("scrollHeight"));
                    }
                }
            });
        </script>
    }

</body>
</html>
