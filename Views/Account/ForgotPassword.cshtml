@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu - Quản lý Kho</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { background-color: #f4f7f6; font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="card shadow-lg border-0 rounded-4" style="width: 100%; max-width: 400px;">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="fa-solid fa-key fa-3x text-warning mb-3"></i>
                <h3 class="fw-bold">Quên Mật Khẩu</h3>
                <p class="text-muted">Nhập tên đăng nhập để khôi phục</p>
            </div>
            
            <form method="post" asp-controller="Account" asp-action="ForgotPassword">
                <div class="mb-4">
                    <label class="form-label fw-semibold">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-user"></i></span>
                        <input name="username" required class="form-control" placeholder="Tên đăng nhập của bạn" />
                    </div>
                </div>
                
                <button type="submit" class="btn btn-warning w-100 py-2 fw-bold fs-5 rounded-3 mb-3 text-white">Gửi liên kết khôi phục</button>
                
                <div class="text-center mt-3">
                    <a asp-action="Login" class="text-decoration-none">Quay lại Đăng nhập</a>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 text-center mt-3" style="font-size: 0.9rem;">
                        <div asp-validation-summary="All" class="text-danger list-unstyled"></div>
                    </div>
                }
            </form>
        </div>
    </div>
</body>
</html>
