@model DuAnCode.Web.Models.InventoryAudit
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.AuditNumber) ? "Tạo phiếu kiểm kê kho" : $"Phiếu kiểm kê {Model.AuditNumber}";
    var warehouses = ViewBag.Warehouses as List<DuAnCode.Web.Models.Warehouse> ?? new List<DuAnCode.Web.Models.Warehouse>();
    var skus = ViewBag.Skus as List<DuAnCode.Web.Models.ViewModels.SkuDto> ?? new List<DuAnCode.Web.Models.ViewModels.SkuDto>();
    var rejectLog = ViewBag.RejectLog as DuAnCode.Web.Models.AuditLog;
    var isLocked = Model.Status == "APPROVED" || Model.Status == "REJECTED";
}

<div class="container-fluid py-3 invoice-root">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <!-- Header section -->
            <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-3">
                <div>
                    <h5 class="fw-bold mb-1 text-primary"><i class="fa-solid fa-clipboard-check me-2"></i>PHIẾU KIỂM KÊ KHO HÀNG</h5>
                    <div class="small text-muted">Biên bản đối chiếu tồn kho sổ sách & tồn kho thực tế</div>
                </div>
                <div class="text-end">
                    <div class="fs-6">Số phiếu: <strong class="text-dark">@(string.IsNullOrWhiteSpace(Model.AuditNumber) ? "Tự động tạo" : Model.AuditNumber)</strong></div>
                    <div class="small text-muted">Ngày: @(Model.Date == default ? DateTime.UtcNow.ToString("dd/MM/yyyy HH:mm") : Model.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</div>
                    <div class="small text-muted mt-1">
                        @{
                            var isAiCreated = Model.AuditNumber?.Contains("-AI-") == true || Model.CreatedBy?.Contains("AI") == true || Model.Reason?.Contains("AI") == true;
                        }
                        Người lập: 
                        @if (isAiCreated)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle fw-medium py-1 px-2">
                                <i class="fa-solid fa-robot me-1"></i>@(Model.CreatedBy ?? "Trợ lý AI WMS")
                            </span>
                        }
                        else
                        {
                            <strong class="text-dark"><i class="fa-solid fa-user me-1 text-secondary opacity-75 small"></i>@(Model.CreatedBy ?? User?.Identity?.Name ?? "Chưa xác định")</strong>
                        }
                    </div>
                    <div class="mt-1">
                        @if (Model.Status == "APPROVED")
                        {
                            <span class="badge bg-success fs-6 px-3 py-1"><i class="fa-solid fa-check me-1"></i>ĐÃ DUYỆT (Đã cân đối tồn)</span>
                        }
                        else if (Model.Status == "REJECTED")
                        {
                            <span class="badge bg-danger fs-6 px-3 py-1"><i class="fa-solid fa-ban me-1"></i>ĐÃ TỪ CHỐI DUYỆT</span>
                        }
                        else if (Model.Status == "PENDING")
                        {
                            <span class="badge bg-warning text-dark fs-6 px-3 py-1"><i class="fa-solid fa-clock me-1"></i>CHỜ DUYỆT</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6 px-3 py-1"><i class="fa-solid fa-pen me-1"></i>BẢN NHÁP</span>
                        }
                    </div>
                </div>
            </div>

            @{
                var stAu = Model.Status ?? "DRAFT";
                var step1ClassAu = "completed";
                var step2ClassAu = stAu == "DRAFT" ? "pending" : (stAu == "PENDING" ? "active" : (stAu == "REJECTED" ? "rejected" : "completed"));
                var step3ClassAu = stAu == "APPROVED" ? "completed" : (stAu == "REJECTED" ? "rejected" : "pending");
                var step3IconAu = stAu == "REJECTED" ? "fa-solid fa-ban" : "fa-solid fa-scale-balanced";
                var step3TitleAu = stAu == "REJECTED" ? "3. Bị từ chối" : (stAu == "APPROVED" ? "3. Đã duyệt & Cân đối" : "3. Cân đối tồn kho");
                var step3SubAu = stAu == "REJECTED" ? "Không điều chỉnh tồn" : (stAu == "APPROVED" ? "Đã khớp sổ sách với thực tế" : "Chờ phê duyệt");
            }
            <!-- Quy trình xử lý phiếu Kiểm kê (Workflow Stepper) -->
            <div class="workflow-stepper">
                <ul class="wms-steps">
                    <li class="wms-step @(stAu == "DRAFT" ? "active" : "completed")">
                        <div class="wms-step-icon"><i class="fa-solid fa-clipboard-list"></i></div>
                        <div class="wms-step-title">1. Khởi tạo kiểm kê</div>
                        <div class="wms-step-desc">Kiểm đếm thực tế</div>
                    </li>
                    <li class="wms-step @step2ClassAu">
                        <div class="wms-step-icon">
                            @if (stAu == "PENDING") { <i class="fa-solid fa-hourglass-half"></i> }
                            else if (stAu == "REJECTED") { <i class="fa-solid fa-circle-xmark"></i> }
                            else { <i class="fa-solid fa-user-check"></i> }
                        </div>
                        <div class="wms-step-title">2. Phê duyệt biên bản</div>
                        <div class="wms-step-desc">@(stAu == "PENDING" ? "Đang chờ quản lý duyệt" : (stAu == "REJECTED" ? "Quản lý từ chối" : "Quản lý đã duyệt"))</div>
                    </li>
                    <li class="wms-step @step3ClassAu">
                        <div class="wms-step-icon"><i class="@step3IconAu"></i></div>
                        <div class="wms-step-title">@step3TitleAu</div>
                        <div class="wms-step-desc">@step3SubAu</div>
                    </li>
                </ul>
            </div>

            @if (Model.Status == "REJECTED")
            {
                var (origReason, rejReason) = DuAnCode.Web.Services.RejectionHelper.ExtractReason(Model.Reason);
                <div class="alert alert-danger border-2 border-danger shadow-sm p-3 mb-4 rounded-3">
                    <div class="d-flex align-items-start">
                        <i class="fa-solid fa-circle-xmark fs-2 text-danger me-3 mt-1"></i>
                        <div class="flex-grow-1">
                            <h6 class="alert-heading fw-bold mb-1 text-danger">PHIẾU KIỂM KÊ ĐÃ BỊ TỪ CHỐI DUYỆT</h6>
                            <div class="p-3 bg-white border border-danger-subtle rounded-2 mb-2">
                                <div class="text-secondary small fw-bold text-uppercase mb-1"><i class="fa-solid fa-triangle-exclamation text-danger me-1"></i>Lý do từ chối:</div>
                                <div class="fs-6 text-danger fw-semibold">@(string.IsNullOrWhiteSpace(rejReason) ? "Không có lý do cụ thể" : rejReason)</div>
                            </div>
                            <div class="small text-muted d-flex flex-wrap gap-4">
                                <span><i class="fa-solid fa-user-xmark text-danger me-1"></i>Người từ chối: <strong class="text-dark">@(rejectLog?.PerformedBy ?? Model.ApprovedBy ?? "Quản lý kho")</strong></span>
                                <span><i class="fa-solid fa-clock text-danger me-1"></i>Thời gian: <strong class="text-dark">@(rejectLog?.PerformedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? Model.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</strong></span>
                                <span><i class="fa-solid fa-shield-halved text-secondary me-1"></i>Tác động: <strong>Không phát sinh điều chỉnh tồn kho</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <form method="post" asp-action="Create" id="auditForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AuditId" value="@Model.AuditId" />
                <input type="hidden" name="AuditNumber" value="@(string.IsNullOrWhiteSpace(Model.AuditNumber) ? "AUTO" : Model.AuditNumber)" />
                <input type="hidden" name="CreatedBy" value="@Model.CreatedBy" />

                <datalist id="sku-options-list">
                    @foreach(var s in skus)
                    {
                        <option value="@s.SkuId" data-name="@s.ProductName" data-unit="@s.Unit">@s.SkuId - @s.ProductName</option>
                    }
                </datalist>

                <!-- Information Grid -->
                <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">
                            Kho cần kiểm kê <span class="text-danger">*</span>
                            <i class="fa-solid fa-circle-question help-icon" data-tooltip="Kho hàng thực hiện đối chiếu số lượng thực tế với số liệu trên phần mềm."></i>
                        </label>
                        <select name="WarehouseId" id="auditWarehouseSelect" class="form-select" @(isLocked ? "disabled" : "") required>
                            <option value="">-- Chọn kho kiểm kê --</option>
                            @foreach(var w in warehouses)
                            {
                                <option value="@w.WarehouseId" selected="@(w.WarehouseId == Model.WarehouseId)">@w.WarehouseName (@w.WarehouseId)</option>
                            }
                        </select>
                        @if (isLocked)
                        {
                            <input type="hidden" name="WarehouseId" value="@Model.WarehouseId" />
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">
                            Ngày kiểm kê
                            <i class="fa-solid fa-circle-question help-icon" data-tooltip="Ngày thực hiện kiểm đếm thực tế tại kho."></i>
                        </label>
                        <input name="Date" type="date" class="form-control" value="@(Model.Date == default ? DateTime.UtcNow.ToString("yyyy-MM-dd") : Model.Date.ToString("yyyy-MM-dd"))" @(isLocked ? "readonly" : "") />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">
                            Lý do / Mục đích kiểm kê
                            <i class="fa-solid fa-circle-question help-icon" data-tooltip="Kiểm kê định kỳ tháng, quý, cuối năm hoặc đột xuất sau sự cố."></i>
                        </label>
                        <input name="Reason" class="form-control" value="@Model.Reason" placeholder="Kiểm kê định kỳ tháng, đối chiếu đột xuất..." @(isLocked ? "readonly" : "") />
                    </div>
                </div>

                <!-- Snapshot / Quick load helper bar -->
                @if (!isLocked)
                {
                    <div class="d-flex justify-content-between align-items-center mb-3 p-2 px-3 bg-primary-subtle border border-primary-subtle rounded-3">
                        <div class="small text-primary-emphasis">
                            <i class="fa-solid fa-wand-magic-sparkles me-1"></i>
                            <strong>Hỗ trợ nhanh:</strong> Bạn có thể tự động nạp tất cả mặt hàng đang có tồn trong kho này vào bảng để tiến hành kiểm đếm.
                        </div>
                        <button type="button" class="btn btn-sm btn-primary shadow-xs" id="btnLoadSnapshot">
                            <i class="fa-solid fa-cloud-arrow-down me-1"></i> Nạp tồn kho hiện tại vào phiếu
                        </button>
                    </div>
                }

                <!-- Lines Table -->
                <div class="table-responsive border rounded shadow-xs mb-3">
                    <table class="table table-hover table-sm align-middle mb-0" id="linesTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 45px" class="text-center">STT</th>
                                <th style="min-width: 150px">
                                    Mã SKU <span class="text-danger">*</span>
                                    <i class="fa-solid fa-circle-question help-icon" data-abbr="SKU"></i>
                                </th>
                                <th style="min-width: 180px">Tên hàng hóa</th>
                                <th style="width: 130px">
                                    Trạng thái
                                    <i class="fa-solid fa-circle-question help-icon" data-tooltip="GOOD: Hàng chuẩn; DAMAGED: Hàng lỗi cách ly"></i>
                                </th>
                                <th style="width: 80px">
                                    ĐVT
                                    <i class="fa-solid fa-circle-question help-icon" data-abbr="ĐVT"></i>
                                </th>
                                <th style="min-width: 110px">
                                    Mã lô (Batch)
                                    <i class="fa-solid fa-circle-question help-icon" data-abbr="Batch"></i>
                                </th>
                                <th style="width: 120px" class="text-end">
                                    SL Sổ sách
                                    <i class="fa-solid fa-circle-question help-icon" data-tooltip="Số lượng tồn kho được ghi nhận trên hệ thống phần mềm trước khi kiểm kê."></i>
                                </th>
                                <th style="width: 120px" class="text-end">
                                    SL Thực tế <span class="text-danger">*</span>
                                    <i class="fa-solid fa-circle-question help-icon" data-tooltip="Số lượng đếm được thực tế trên giá kệ tại thời điểm kiểm kê."></i>
                                </th>
                                <th style="width: 110px" class="text-center">
                                    Chênh lệch
                                    <i class="fa-solid fa-circle-question help-icon" data-tooltip="Hiệu số giữa SL Thực tế và SL Sổ sách (> 0: Thừa hàng, < 0: Thiếu hàng)."></i>
                                </th>
                                <th style="min-width: 140px">Ghi chú</th>
                                @if (!isLocked)
                                {
                                    <th style="width: 60px" class="text-center no-print">&nbsp;</th>
                                }
                            </tr>
                        </thead>
                        <tbody id="linesTableBody">
                            @if(Model.Lines != null && Model.Lines.Any())
                            {
                                for (int i = 0; i < Model.Lines.Count; i++)
                                {
                                    var ln = Model.Lines[i];
                                    var matchedSku = skus.FirstOrDefault(s => s.SkuId == ln.SkuId);
                                    var diff = ln.ActualQuantity - ln.SystemQuantity;
                                    var diffClass = diff == 0 ? "text-success" : (diff > 0 ? "text-primary fw-bold" : "text-danger fw-bold");
                                    var diffSign = diff > 0 ? $"+{diff}" : diff.ToString();

                                    <tr class="audit-row">
                                        <td class="text-center idx">@(i+1)</td>
                                        <td>
                                            @if (isLocked)
                                            {
                                                <input name="Lines[@i].SkuId" class="form-control form-control-sm bg-light" value="@ln.SkuId" readonly />
                                            }
                                            else
                                            {
                                                <input list="sku-options-list" name="Lines[@i].SkuId" class="form-control form-control-sm sku-select" value="@ln.SkuId" placeholder="Chọn SKU..." required />
                                            }
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm product-name bg-light" value="@(matchedSku?.ProductName ?? ln.SkuId)" readonly />
                                        </td>
                                        <td>
                                            @if (isLocked)
                                            {
                                                <span class="badge @(ln.StockStatus == "DAMAGED" ? "bg-danger" : "bg-success")">
                                                    @(ln.StockStatus == "DAMAGED" ? "Lỗi (DAMAGED)" : "Tốt (GOOD)")
                                                </span>
                                                <input type="hidden" name="Lines[@i].StockStatus" value="@ln.StockStatus" />
                                            }
                                            else
                                            {
                                                <select name="Lines[@i].StockStatus" class="form-select form-select-sm stock-status-select">
                                                    <option value="GOOD" selected="@(ln.StockStatus != "DAMAGED")">Hàng tốt (GOOD)</option>
                                                    <option value="DAMAGED" selected="@(ln.StockStatus == "DAMAGED")">Hàng lỗi (DAMAGED)</option>
                                                </select>
                                            }
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm unit bg-light" value="@(matchedSku?.Unit ?? "Cái")" readonly />
                                        </td>
                                        <td>
                                            <input name="Lines[@i].BatchNumber" class="form-control form-control-sm" value="@ln.BatchNumber" placeholder="Lô (nếu có)..." @(isLocked ? "readonly" : "") />
                                        </td>
                                        <td>
                                            <input name="Lines[@i].SystemQuantity" type="number" class="form-control form-control-sm bg-light text-end system-qty" value="@ln.SystemQuantity" readonly />
                                        </td>
                                        <td>
                                            <input name="Lines[@i].ActualQuantity" type="number" min="0" value="@ln.ActualQuantity" class="form-control form-control-sm text-end fw-bold text-primary actual-qty" @(isLocked ? "readonly" : "") required />
                                        </td>
                                        <td class="text-center diff-cell @diffClass">
                                            @diffSign
                                        </td>
                                        <td>
                                            <input name="Lines[@i].Notes" class="form-control form-control-sm" value="@ln.Notes" placeholder="Lý do chênh lệch..." @(isLocked ? "readonly" : "") />
                                        </td>
                                        @if (!isLocked)
                                        {
                                            <td class="text-center no-print">
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-line btn-icon-only"><i class="fa-solid fa-trash-can"></i></button>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="6" class="text-end fw-bold text-uppercase text-secondary">Tổng cộng</td>
                                <td class="text-end fw-bold" id="totalSystemQty">0</td>
                                <td class="text-end fw-bold text-primary" id="totalActualQty">0</td>
                                <td class="text-center fw-bold" id="totalDiffSummary">0</td>
                                <td colspan="@(isLocked ? 1 : 2)">&nbsp;</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @if (!isLocked)
                {
                    <div class="mb-4 no-print">
                        <button type="button" class="btn btn-outline-primary" id="btnAddLine">
                            <i class="fa-solid fa-plus me-1"></i> Thêm mặt hàng
                        </button>
                    </div>
                }

                <!-- Action Button Footer: natural bottom flow -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4 no-print">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                            <i class="fa-solid fa-print me-1"></i> In phiếu
                        </button>
                        @if (!isLocked)
                        {
                            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Phiếu Kiểm Kê
                            </button>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const skuList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(skus));
    const isLockedMode = @(isLocked ? "true" : "false");

    function createAuditRow(idx, skuId = '', prodName = '', unit = 'Cái', batch = '', stockStatus = 'GOOD', sysQty = 0, actQty = 0, notes = '') {
        const tr = document.createElement('tr');
        tr.className = 'audit-row';
        const diff = actQty - sysQty;
        const diffClass = diff === 0 ? 'text-success' : (diff > 0 ? 'text-primary fw-bold' : 'text-danger fw-bold');
        const diffSign = diff > 0 ? `+${diff}` : diff;

        tr.innerHTML = `
            <td class="text-center idx">${idx}</td>
            <td>
                <input list="sku-options-list" name="Lines[${idx-1}].SkuId" class="form-control form-control-sm sku-select" value="${escapeHtml(skuId)}" placeholder="Chọn SKU..." required />
            </td>
            <td>
                <input type="text" class="form-control form-control-sm product-name bg-light" value="${escapeHtml(prodName)}" readonly />
            </td>
            <td>
                <select name="Lines[${idx-1}].StockStatus" class="form-select form-select-sm stock-status-select">
                    <option value="GOOD" ${stockStatus !== 'DAMAGED' ? 'selected' : ''}>Hàng tốt (GOOD)</option>
                    <option value="DAMAGED" ${stockStatus === 'DAMAGED' ? 'selected' : ''}>Hàng lỗi (DAMAGED)</option>
                </select>
            </td>
            <td>
                <input type="text" class="form-control form-control-sm unit bg-light" value="${escapeHtml(unit)}" readonly />
            </td>
            <td>
                <input name="Lines[${idx-1}].BatchNumber" class="form-control form-control-sm" value="${escapeHtml(batch)}" placeholder="Lô (nếu có)..." />
            </td>
            <td>
                <input name="Lines[${idx-1}].SystemQuantity" type="number" class="form-control form-control-sm bg-light text-end system-qty" value="${sysQty}" readonly />
            </td>
            <td>
                <input name="Lines[${idx-1}].ActualQuantity" type="number" min="0" value="${actQty}" class="form-control form-control-sm text-end fw-bold text-primary actual-qty" required />
            </td>
            <td class="text-center diff-cell ${diffClass}">
                ${diffSign}
            </td>
            <td>
                <input name="Lines[${idx-1}].Notes" class="form-control form-control-sm" value="${escapeHtml(notes)}" placeholder="Lý do chênh lệch..." />
            </td>
            <td class="text-center no-print">
                <button type="button" class="btn btn-sm btn-outline-danger remove-line btn-icon-only"><i class="fa-solid fa-trash-can"></i></button>
            </td>
        `;

        bindRowEvents(tr);
        return tr;
    }

    function escapeHtml(text) {
        if (!text) return '';
        return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function bindRowEvents(row) {
        const skuSelect = row.querySelector('.sku-select');
        const actualInput = row.querySelector('.actual-qty');
        const removeBtn = row.querySelector('.remove-line');

        skuSelect?.addEventListener('change', function () {
            const val = this.value.trim();
            const found = skuList.find(x => x.SkuId.toLowerCase() === val.toLowerCase());
            if (found) {
                this.value = found.SkuId;
                row.querySelector('.product-name').value = found.ProductName || '';
                row.querySelector('.unit').value = found.Unit || 'Cái';

                // Look up current stock in selected warehouse for system qty
                const whId = document.getElementById('auditWarehouseSelect')?.value;
                if (whId) {
                    fetch(`/api/stock/available?warehouseId=${encodeURIComponent(whId)}&skuId=${encodeURIComponent(found.SkuId)}`)
                        .then(r => r.json())
                        .then(data => {
                            if (typeof data.available === 'number') {
                                row.querySelector('.system-qty').value = data.available;
                                updateRowDiff(row);
                                recalcSummary();
                            }
                        })
                        .catch(() => {});
                }
            }
        });

        actualInput?.addEventListener('input', function () {
            updateRowDiff(row);
            recalcSummary();
        });

        removeBtn?.addEventListener('click', function () {
            row.remove();
            updateIndexes();
            recalcSummary();
        });
    }

    function updateRowDiff(row) {
        const sys = parseFloat(row.querySelector('.system-qty')?.value) || 0;
        const act = parseFloat(row.querySelector('.actual-qty')?.value) || 0;
        const diff = act - sys;
        const diffCell = row.querySelector('.diff-cell');
        if (diffCell) {
            diffCell.className = `text-center diff-cell ${diff === 0 ? 'text-success' : (diff > 0 ? 'text-primary fw-bold' : 'text-danger fw-bold')}`;
            diffCell.textContent = diff > 0 ? `+${diff}` : diff;
        }
    }

    function updateIndexes() {
        const rows = document.querySelectorAll('#linesTableBody tr');
        rows.forEach((r, i) => {
            const idxCell = r.querySelector('.idx');
            if (idxCell) idxCell.textContent = i + 1;
            r.querySelectorAll('input, select').forEach(inp => {
                if (inp.name) {
                    inp.name = inp.name.replace(/Lines\[\d+\]/, `Lines[${i}]`);
                }
            });
        });
    }

    function recalcSummary() {
        let totalSys = 0;
        let totalAct = 0;
        let diffCount = 0;

        document.querySelectorAll('#linesTableBody tr').forEach(r => {
            const sys = parseFloat(r.querySelector('.system-qty')?.value) || 0;
            const act = parseFloat(r.querySelector('.actual-qty')?.value) || 0;
            totalSys += sys;
            totalAct += act;
            if (sys !== act) diffCount++;
        });

        const sysElem = document.getElementById('totalSystemQty');
        const actElem = document.getElementById('totalActualQty');
        const diffElem = document.getElementById('totalDiffSummary');

        if (sysElem) sysElem.textContent = totalSys.toLocaleString();
        if (actElem) actElem.textContent = totalAct.toLocaleString();
        if (diffElem) {
            const totalDiff = totalAct - totalSys;
            const sign = totalDiff > 0 ? `+${totalDiff}` : totalDiff;
            diffElem.textContent = `${sign} (${diffCount} SP lệch)`;
            diffElem.className = `text-center fw-bold ${totalDiff === 0 ? 'text-success' : 'text-danger'}`;
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        if (!isLockedMode) {
            document.querySelectorAll('#linesTableBody tr').forEach(bindRowEvents);

            document.getElementById('btnAddLine')?.addEventListener('click', function () {
                const tbody = document.getElementById('linesTableBody');
                const idx = tbody.children.length + 1;
                const newRow = createAuditRow(idx);
                tbody.appendChild(newRow);
                updateIndexes();
                newRow.querySelector('.sku-select')?.focus();
            });

            // Auto-populate warehouse stock snapshot
            document.getElementById('btnLoadSnapshot')?.addEventListener('click', function () {
                const whSelect = document.getElementById('auditWarehouseSelect');
                const whId = whSelect?.value;
                if (!whId) {
                    window.showToast('Vui lòng chọn Kho cần kiểm kê trước khi nạp tồn kho!', 'warning');
                    whSelect?.focus();
                    return;
                }

                if (!confirm(`Bạn có chắc muốn nạp toàn bộ danh mục hàng tồn kho hiện tại của ${whSelect.options[whSelect.selectedIndex].text} vào phiếu?`)) {
                    return;
                }

                this.disabled = true;
                this.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang tải...';

                fetch(`/api/stock/warehouse-snapshot?warehouseId=${encodeURIComponent(whId)}`)
                    .then(r => r.json())
                    .then(res => {
                        this.disabled = false;
                        this.innerHTML = '<i class="fa-solid fa-cloud-arrow-down me-1"></i> Nạp tồn kho hiện tại vào phiếu';

                        if (!res.items || res.items.length === 0) {
                            window.showToast('Kho này hiện không có mặt hàng nào có tồn kho (> 0)!', 'warning');
                            return;
                        }

                        const tbody = document.getElementById('linesTableBody');
                        tbody.innerHTML = ''; // clear old rows

                        res.items.forEach((item, i) => {
                            const row = createAuditRow(
                                i + 1,
                                item.skuId,
                                item.productName,
                                item.unit,
                                item.batchNumber,
                                item.stockStatus || 'GOOD',
                                item.systemQuantity,
                                item.systemQuantity, // default actual = system for counting
                                ''
                            );
                            tbody.appendChild(row);
                        });

                        updateIndexes();
                        recalcSummary();
                    })
                    .catch(err => {
                        this.disabled = false;
                        this.innerHTML = '<i class="fa-solid fa-cloud-arrow-down me-1"></i> Nạp tồn kho hiện tại vào phiếu';
                        window.showToast('Lỗi nạp dữ liệu tồn kho: ' + err.message, 'error');
                    });
            });

            // If empty, add first row
            if (document.querySelectorAll('#linesTableBody tr').length === 0) {
                document.getElementById('btnAddLine')?.click();
            }
        }

        recalcSummary();
    });
</script>

