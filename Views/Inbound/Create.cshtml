@model DuAnCode.Web.Models.ViewModels.VoucherPageViewModel
@{
    ViewData["Title"] = "Phiếu Nhập kho ";
    var skus = Model?.Skus ?? new List<DuAnCode.Web.Models.ViewModels.SkuDto>();
    var warehouses = Model?.Warehouses ?? new List<DuAnCode.Web.Models.Warehouse>();
    var recent = Model?.Recent ?? new List<DuAnCode.Web.Models.InventoryVoucher>();
}

<div class="container-fluid py-2 invoice-root">
    <div class="card">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <div class="fw-bold">CÔNG TY NỘI THẤT VFS</div>
                    <div class="small text-muted">Mẫu số: PN-01</div>
                </div>
                <div class="text-end">
                    <div>Số phiếu: <span id="voucherNumber">Tự động tạo</span></div>
                    <div>Ngày: @DateTime.UtcNow.ToString("dd/MM/yyyy")</div>
                </div>
            </div>

            <h4 class="text-center mb-4 text-primary fw-bold">PHIẾU NHẬP KHO</h5>

            <form method="post" asp-action="Create" asp-controller="Inbound">
<datalist id="sku-options-list">
@foreach(var s in skus){ <option value="@s.SkuId">@s.ProductName</option> }
</datalist>
                @Html.AntiForgeryToken()
                <input type="hidden" name="VoucherId" value="@Model?.Form?.VoucherId" />
                <input type="hidden" name="VoucherNumber" value="Tự động tạo" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Nhà cung cấp</label>
                        <input asp-for="Form.Counterparty" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Địa chỉ</label>
                        <input asp-for="Form.Address" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Kho</label>
                        <select asp-for="Form.WarehouseId" class="form-select">
                            @foreach(var w in warehouses) { <option value="@w.WarehouseId">@w.WarehouseName</option> }
                        </select>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Chứng từ gốc (Mã hóa đơn/PO)</label>
                        <input asp-for="Form.ReferenceDocument" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Lý do</label>
                        <input asp-for="Form.Reason" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4 text-end align-self-end">
                        <button type="button" class="btn btn-outline-secondary fw-semibold me-2 no-print" onclick="window.print()">In phiếu</button>
                        <button type="submit" class="btn btn-primary fw-semibold shadow-sm no-print">Lưu phiếu</button>
                    </div>
                </div>

                
<style>
    #linesTable { font-size: 0.85rem; }
    #linesTable th, #linesTable td { padding: 0.4rem 0.3rem !important; vertical-align: middle; white-space: nowrap; }
    #linesTable input.form-control-sm { padding: 0.25rem 0.4rem; font-size: 0.85rem; border-radius: 4px; border: 1px solid #e2e8f0; width: 100%; min-width: 70px; }
    #linesTable input.form-control-sm:focus { border-color: #3b82f6; box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.15); }
    #linesTable .product-name { min-width: 150px !important; }
    #linesTable .sku-select { min-width: 110px !important; }
</style>
<div class="table-responsive border rounded shadow-sm mb-3">
                    <table class="table table-hover table-sm align-middle " id="linesTable">
                        <thead class="table-light">
                            <tr><th style="width:40px">STT</th><th >Mã hàng</th><th >Tên hàng</th><th >ĐVT</th><th >SL Chứng từ</th><th >SL Thực tế</th><th >Mã lô</th><th >HSD</th><th >Đơn giá</th><th >Thành tiền</th><th style="width:80px">&nbsp;</th></tr>
                        </thead>
                        <tbody>
                        @* If editing, render existing lines *@
                        @if(Model?.Form?.Lines != null && Model.Form.Lines.Any()){
                            for(int i=0;i<Model.Form.Lines.Count;i++){
                                var ln = Model.Form.Lines[i];
                                <tr>
                                    <td class="text-center">@(i+1)</td>
                                    <td>
                                        
                                        @{ var skuErr = ViewData.ModelState.TryGetValue($"Lines[{i}].SkuId", out var skuState) && skuState.Errors.Count > 0 ? "input-validation-error" : ""; }
                                        <input list="sku-options" name="Form.Lines[@i].SkuId" class="form-control form-control-sm sku-select @skuErr" value="@ln.SkuId" />
                                        <datalist id="sku-options">
                                            @foreach(var s in skus){ <option value="@s.SkuId"></option> }
                                        </datalist>
</td>
                                    <td>
                                        @{ var nameErr = ViewData.ModelState.TryGetValue($"Lines[{i}].ProductName", out var n) && n.Errors.Count > 0 ? "input-validation-error" : ""; }
                                        <input name="Form.Lines[@i].ProductName" class="form-control form-control-sm product-name @nameErr" value="@ln.ProductName" /></td>
                                    <td><input name="Form.Lines[@i].Unit" class="form-control form-control-sm unit" value="@ln.Unit" /></td>
                                    <td><input name="Form.Lines[@i].DocumentQuantity" type="number" min="0" value="@ln.DocumentQuantity" class="form-control form-control-sm" /></td>
                                    <td><input name="Form.Lines[@i].Quantity" type="number" min="0" value="@ln.Quantity" class="form-control form-control-sm qty" /></td>
                                    <td><input name="Form.Lines[@i].BatchNumber" class="form-control form-control-sm" value="@ln.BatchNumber" /></td>
                                    <td><input name="Form.Lines[@i].ExpiryDate" type="date" class="form-control form-control-sm" value="@(ln.ExpiryDate?.ToString("yyyy-MM-dd"))" /></td>
                                    <td><input name="Form.Lines[@i].UnitPrice" type="number" step="0.01" value="@ln.UnitPrice" class="form-control form-control-sm price" /></td>
                                    <td class="line-total">@(ln.UnitPrice * ln.Quantity)</td>
                                    <td class="text-center"><button type="button" class="btn btn-sm btn-danger remove-line">-</button></td>
                                    <input type="hidden" name="Form.Lines[@i].Id" value="@ln.Id" />
                                </tr>
                            }
                        }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="9" class="text-end fw-bold text-uppercase text-muted">Tổng cộng</td>
                                <td class="fw-bold" id="totalAmount">0</td>
                                <td>&nbsp;</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mb-3">
                    <button type="button" class="btn btn-outline-primary no-print" id="addLine">+ Thêm hàng hóa</button>
                </div>
            </form>

            <!-- Recent history removed to avoid duplication with Dashboard -->
        </div>
    </div>
</div>

<script>
    const skus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(skus));

    function createRow(idx) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="text-center">${idx}</td>
            <td>
                <input list="sku-options-list" name="Form.Lines[${idx-1}].SkuId" class="form-control form-control-sm sku-select" placeholder="Mã SKU (tự nhập...)" />
            </td>
            <td><input name="Form.Lines[${idx-1}].ProductName" class="form-control form-control-sm product-name" /></td>
            <td><input name="Form.Lines[${idx-1}].Unit" class="form-control form-control-sm unit" value="Cái" /></td>
            <td><input name="Form.Lines[${idx-1}].DocumentQuantity" type="number" min="0" value="1" class="form-control form-control-sm" /></td>
            <td><input name="Form.Lines[${idx-1}].Quantity" type="number" min="0" value="1" class="form-control form-control-sm qty" /></td>
            <td><input name="Form.Lines[${idx-1}].BatchNumber" class="form-control form-control-sm" /></td>
            <td><input name="Form.Lines[${idx-1}].ExpiryDate" type="date" class="form-control form-control-sm" /></td>
            <td><input name="Form.Lines[${idx-1}].UnitPrice" type="number" step="0.01" value="0" class="form-control form-control-sm price" /></td>
            <td class="line-total">0</td>
            <td class="text-center"><button type="button" class="btn btn-sm btn-danger remove-line">-</button></td>
        `;
        return tr;
    }

    
    function updateIndexes() {
        const rows = document.querySelectorAll('#linesTable tbody tr');
        rows.forEach((r, i) => {
            r.querySelector('td:first-child').innerText = i + 1; // STT
            const inputs = r.querySelectorAll('input, select');
            inputs.forEach(inp => {
                if (inp.name) {
                    inp.name = inp.name.replace(/Lines\[\d+\]/, `Lines[${i}]`);
                }
            });
        });
    }

    function recalc() {
        const rows = document.querySelectorAll('#linesTable tbody tr');
        let total = 0;
        rows.forEach((r,i)=>{
            const qty = parseFloat(r.querySelector('.qty').value) || 0;
            const price = parseFloat(r.querySelector('.price').value) || 0;
            const lt = qty * price;
            r.querySelector('.line-total').innerText = lt.toLocaleString();
            total += lt;
        });
        document.getElementById('totalAmount').innerText = total.toLocaleString();
    }

    document.getElementById('addLine').addEventListener('click', ()=>{
        const tbody = document.querySelector('#linesTable tbody');
        const idx = tbody.children.length + 1;
        const row = createRow(idx);
        tbody.appendChild(row);
        row.querySelector('.sku-select').addEventListener('change', function(){
            const s = skus.find(x => x.SkuId === this.value);
            if (s) {
                const r = this.closest('tr');
                r.querySelector('.product-name').value = s.ProductName || '';
                r.querySelector('.unit').value = s.Unit || 'Cái';
            }
        });
        row.querySelector('.qty').addEventListener('input', recalc);
        row.querySelector('.price').addEventListener('input', recalc);
        row.querySelector('.remove-line').addEventListener('click', function(){ this.closest('tr').remove(); updateIndexes(); recalc(); });
    });

    // add one row by default
    document.getElementById('addLine').click();
</script>

<style>
    @@media print {
        .sidebar, .no-print, .btn { display:none !important; }
        .invoice-root { margin:0; }
    }
</style>

