@model DuAnCode.Web.Models.ViewModels.VoucherPageViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model?.Form?.VoucherNumber) ? "Tạo Phiếu Nhập kho" : $"Phiếu Nhập kho {Model.Form.VoucherNumber}";
    var skus = Model?.Skus ?? new List<DuAnCode.Web.Models.ViewModels.SkuDto>();
    var warehouses = Model?.Warehouses ?? new List<DuAnCode.Web.Models.Warehouse>();
    var isLocked = Model?.Form?.Status == "APPROVED" || Model?.Form?.Status == "REJECTED";
}

<div class="container-fluid py-2 invoice-root">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-3">
                <div>
                    <div class="fw-bold fs-6 text-secondary">CÔNG TY NỘI THẤT VFS</div>
                    <div class="small text-muted">Mẫu số: PN-01 (Phiếu Nhập Kho Hàng Hóa)</div>
                </div>
                <div class="text-end">
                    <div>Số phiếu: <strong class="text-dark">@(string.IsNullOrWhiteSpace(Model?.Form?.VoucherNumber) ? "Tự động tạo" : Model.Form.VoucherNumber)</strong></div>
                    <div class="small text-muted">Ngày: @(Model?.Form?.Date == default || Model?.Form?.Date == null ? DateTime.UtcNow.ToString("dd/MM/yyyy") : Model.Form.Date.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</div>
                    <div class="small mt-1">
                        <span class="text-muted">Người lập:</span>
                        @{
                            var isAiVoucher = Model?.Form?.VoucherNumber?.Contains("-AI-") == true || Model?.Form?.CreatedBy?.Contains("AI") == true || Model?.Form?.Reason?.Contains("AI") == true;
                            var creatorName = !string.IsNullOrWhiteSpace(Model?.Form?.CreatedBy) ? Model.Form.CreatedBy : (isAiVoucher ? "Trợ lý AI WMS" : (User?.Identity?.Name ?? "Chưa xác định"));
                        }
                        @if (isAiVoucher)
                        {
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle fw-semibold" data-tooltip="Phiếu này do Trợ lý AI WMS khởi tạo tự động">
                                <i class="fa-solid fa-robot me-1"></i>@creatorName
                            </span>
                        }
                        else
                        {
                            <strong class="text-dark"><i class="fa-solid fa-user me-1 text-secondary small"></i>@creatorName</strong>
                        }
                    </div>
                    <div class="mt-2">
                        @if (Model?.Form?.Status == "APPROVED")
                        {
                            <span class="badge bg-success fs-6 px-3 py-1"><i class="fa-solid fa-check me-1"></i>ĐÃ DUYỆT (Đã cộng tồn)</span>
                        }
                        else if (Model?.Form?.Status == "REJECTED")
                        {
                            <span class="badge bg-danger fs-6 px-3 py-1"><i class="fa-solid fa-ban me-1"></i>ĐÃ TỪ CHỐI DUYỆT</span>
                        }
                        else if (Model?.Form?.Status == "PENDING")
                        {
                            <span class="badge bg-warning text-dark fs-6 px-3 py-1"><i class="fa-solid fa-clock me-1"></i>CHỜ DUYỆT</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6 px-3 py-1"><i class="fa-solid fa-pen me-1"></i>BẢN NHÁP</span>
                        }
                    </div>
                </div>
            </div>

            <h4 class="text-center mb-4 text-primary fw-bold text-uppercase">
                <i class="fa-solid fa-box-arrow-in-down me-2"></i>PHIẾU NHẬP KHO
            </h4>

            @{
                var st = Model?.Form?.Status ?? "DRAFT";
                var step1Class = "completed";
                var step2Class = st == "DRAFT" ? "pending" : (st == "PENDING" ? "active" : (st == "REJECTED" ? "rejected" : "completed"));
                var step3Class = st == "APPROVED" ? "completed" : (st == "REJECTED" ? "rejected" : "pending");
                var step3Icon = st == "REJECTED" ? "fa-solid fa-ban" : "fa-solid fa-boxes-stacked";
                var step3Title = st == "REJECTED" ? "3. Bị từ chối" : (st == "APPROVED" ? "3. Đã duyệt nhập kho" : "3. Hoàn tất nhập kho");
                var step3Sub = st == "REJECTED" ? "Không cộng tồn" : (st == "APPROVED" ? "Đã cộng tồn thực tế" : "Chờ phê duyệt");
            }
            <!-- Quy trình xử lý phiếu (Workflow Stepper) -->
            <div class="workflow-stepper">
                <ul class="wms-steps">
                    <li class="wms-step @(st == "DRAFT" ? "active" : "completed")">
                        <div class="wms-step-icon"><i class="fa-solid fa-file-pen"></i></div>
                        <div class="wms-step-title">1. Khởi tạo phiếu</div>
                        <div class="wms-step-desc">Soạn thảo chứng từ</div>
                    </li>
                    <li class="wms-step @step2Class">
                        <div class="wms-step-icon">
                            @if (st == "PENDING") { <i class="fa-solid fa-hourglass-half"></i> }
                            else if (st == "REJECTED") { <i class="fa-solid fa-circle-xmark"></i> }
                            else { <i class="fa-solid fa-user-check"></i> }
                        </div>
                        <div class="wms-step-title">2. Phê duyệt</div>
                        <div class="wms-step-desc">@(st == "PENDING" ? "Đang chờ quản lý duyệt" : (st == "REJECTED" ? "Quản lý từ chối" : "Quản lý đã duyệt"))</div>
                    </li>
                    <li class="wms-step @step3Class">
                        <div class="wms-step-icon"><i class="@step3Icon"></i></div>
                        <div class="wms-step-title">@step3Title</div>
                        <div class="wms-step-desc">@step3Sub</div>
                    </li>
                </ul>
            </div>

            @if (Model?.Form?.Status == "REJECTED")
            {
                <div class="alert alert-danger border-2 border-danger shadow-sm p-3 mb-4 rounded-3">
                    <div class="d-flex align-items-start">
                        <i class="fa-solid fa-ban fs-2 text-danger me-3 mt-1"></i>
                        <div class="flex-grow-1">
                            <h6 class="alert-heading fw-bold mb-1 text-danger">PHIẾU ĐÃ BỊ TỪ CHỐI DUYỆT</h6>
                            <div class="p-3 bg-white border border-danger-subtle rounded-2 mb-2">
                                <div class="text-secondary small fw-bold text-uppercase mb-1"><i class="fa-solid fa-triangle-exclamation text-danger me-1"></i>Lý do từ chối phê duyệt:</div>
                                <div class="fs-6 text-danger fw-semibold">@(string.IsNullOrWhiteSpace(Model?.Form?.RejectionReason) ? "Không có lý do cụ thể" : Model.Form.RejectionReason)</div>
                            </div>
                            <div class="small text-muted d-flex flex-wrap gap-4">
                                <span><i class="fa-solid fa-user-xmark text-danger me-1"></i>Người từ chối: <strong class="text-dark">@(Model?.Form?.ApprovedBy ?? "Quản lý kho")</strong></span>
                                <span><i class="fa-solid fa-clock text-danger me-1"></i>Thời gian: <strong class="text-dark">@(Model?.Form?.RejectedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? Model?.Form?.Date?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</strong></span>
                                <span><i class="fa-solid fa-shield-halved text-secondary me-1"></i>Tác động: <strong>Không phát sinh tồn kho</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <form method="post" asp-action="Create" asp-controller="Inbound" id="inboundForm">
                <datalist id="sku-options-list">
                    @foreach(var s in skus){ <option value="@s.SkuId" data-name="@s.ProductName" data-unit="@s.Unit">@s.SkuId - @s.ProductName</option> }
                </datalist>
                @Html.AntiForgeryToken()
                <input type="hidden" name="VoucherId" value="@Model?.Form?.VoucherId" />
                <input type="hidden" name="VoucherNumber" value="@(string.IsNullOrWhiteSpace(Model?.Form?.VoucherNumber) ? "Tự động tạo" : Model.Form.VoucherNumber)" />
                <input type="hidden" name="Form.VoucherId" value="@Model?.Form?.VoucherId" />
                <input type="hidden" name="Form.VoucherNumber" value="@Model?.Form?.VoucherNumber" />
                <input type="hidden" name="Form.CreatedBy" value="@Model?.Form?.CreatedBy" />
                <input type="hidden" name="Form.Date" value="@(Model?.Form?.Date?.ToString("yyyy-MM-ddTHH:mm:ss") ?? DateTime.UtcNow.ToString("yyyy-MM-ddTHH:mm:ss"))" />
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="p-3 bg-light rounded-3 border mb-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase">
                                Nhà cung cấp <span class="text-danger">*</span>
                                <i class="fa-solid fa-circle-question help-icon" data-tooltip="Tên công ty hoặc đại lý đối tác giao hàng hóa đến kho."></i>
                            </label>
                            <input asp-for="Form.Counterparty" class="form-control" placeholder="Tên nhà cung cấp..." readonly="@isLocked" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase">
                                Địa chỉ nhà cung cấp
                                <i class="fa-solid fa-circle-question help-icon" data-tooltip="Địa chỉ trụ sở hoặc kho xuất hàng của nhà cung cấp."></i>
                            </label>
                            <input asp-for="Form.Address" class="form-control" placeholder="Địa chỉ NCC..." readonly="@isLocked" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-secondary small text-uppercase">
                                Kho tiếp nhận nhập <span class="text-danger">*</span>
                                <i class="fa-solid fa-circle-question help-icon" data-tooltip="Kho vật lý trực tiếp tiếp nhận và lưu trữ lô hàng này."></i>
                            </label>
                            <select asp-for="Form.WarehouseId" class="form-select fw-semibold" disabled="@isLocked">
                                @foreach(var w in warehouses) { <option value="@w.WarehouseId">@w.WarehouseName (@w.WarehouseId)</option> }
                            </select>
                            @if (isLocked) { <input type="hidden" name="Form.WarehouseId" value="@Model?.Form?.WarehouseId" /> }
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small text-uppercase">
                                Chứng từ gốc (Mã hóa đơn/PO)
                                <i class="fa-solid fa-circle-question help-icon" data-tooltip="Số đơn mua hàng (Purchase Order - PO) hoặc số hóa đơn VAT gốc từ nhà cung cấp kèm theo hàng."></i>
                            </label>
                            <input asp-for="Form.ReferenceDocument" class="form-control" placeholder="Số hóa đơn GTGT, số đơn mua hàng PO..." readonly="@isLocked" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-secondary small text-uppercase">
                                Lý do nhập kho
                                <i class="fa-solid fa-circle-question help-icon" data-tooltip="Mục đích nhập: Mua mới từ nhà cung cấp, nhập bù hàng bảo hành hoặc khách trả lại."></i>
                            </label>
                            <input asp-for="Form.Reason" class="form-control" placeholder="Nhập mua mới từ NCC, nhập trả hàng, nhập bù..." readonly="@isLocked" />
                        </div>
                    </div>
                </div>

                <style>
                    #linesTable { font-size: 0.85rem; }
                    #linesTable th, #linesTable td { padding: 0.45rem 0.35rem !important; vertical-align: middle; white-space: nowrap; }
                    #linesTable input.form-control-sm { padding: 0.25rem 0.4rem; font-size: 0.85rem; border-radius: 4px; border: 1px solid #cbd5e1; width: 100%; min-width: 70px; }
                    #linesTable input.form-control-sm:focus { border-color: #3b82f6; box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.15); }
                    #linesTable .product-name { min-width: 170px !important; }
                    #linesTable .sku-select { min-width: 130px !important; }
                </style>

                <div class="table-responsive border rounded shadow-xs mb-3">
                    <table class="table table-hover table-sm align-middle mb-0" id="linesTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 40px" class="text-center">STT</th>
                                <th>
                                    Mã hàng <span class="text-danger">*</span>
                                    <i class="fa-solid fa-circle-question help-icon" data-abbr="SKU"></i>
                                </th>
                                <th>
                                    Tên hàng hóa <span class="text-danger">*</span>
                                    <i class="fa-solid fa-circle-question help-icon" data-tooltip="Tên sản phẩm (Tự động điền theo SKU có sẵn hoặc tự nhập tên khi thêm mã mới)"></i>
                                </th>
                                <th style="width: 75px">
                                    ĐVT
                                    <i class="fa-solid fa-circle-question help-icon" data-abbr="ĐVT"></i>
                                </th>
                                <th style="width: 110px" class="text-end">
                                    SL Chứng từ
                                    <i class="fa-solid fa-circle-question help-icon" data-tooltip="Số lượng ghi trên hóa đơn hoặc phiếu giao hàng bàn giao từ đối tác."></i>
                                </th>
                                <th style="width: 110px" class="text-end">
                                    SL Thực nhận <span class="text-danger">*</span>
                                    <i class="fa-solid fa-circle-question help-icon" data-tooltip="Số lượng thực tế thủ kho kiểm đếm nhận vào giá kệ kho."></i>
                                </th>
                                <th>
                                    Mã lô (Batch)
                                    <i class="fa-solid fa-circle-question help-icon" data-abbr="Batch"></i>
                                </th>
                                <th>
                                    HSD
                                    <i class="fa-solid fa-circle-question help-icon" data-abbr="HSD"></i>
                                </th>
                                <th style="width: 120px" class="text-end">
                                    Đơn giá
                                    <i class="fa-solid fa-circle-question help-icon" data-tooltip="Giá mua vào trên một đơn vị hàng hóa từ nhà cung cấp theo chứng từ."></i>
                                </th>
                                <th style="width: 130px" class="text-end">
                                    Thành tiền
                                    <i class="fa-solid fa-circle-question help-icon" data-tooltip="Tổng giá trị = Số lượng thực nhận × Đơn giá."></i>
                                </th>
                                @if (!isLocked) { <th style="width: 50px" class="text-center no-print">&nbsp;</th> }
                            </tr>
                        </thead>
                        <tbody id="linesTableBody">
                            @if(Model?.Form?.Lines != null && Model.Form.Lines.Any()){
                                for(int i=0;i<Model.Form.Lines.Count;i++){
                                    var ln = Model.Form.Lines[i];
                                    var isKnownSku = skus.Any(s => string.Equals(s.SkuId, ln.SkuId, StringComparison.OrdinalIgnoreCase));
                                    <tr class="inbound-row">
                                        <td class="text-center idx">@(i+1)</td>
                                        <td>
                                            @if (isLocked)
                                            {
                                                <input name="Form.Lines[@i].SkuId" class="form-control form-control-sm sku-select bg-light" value="@ln.SkuId" readonly />
                                            }
                                            else
                                            {
                                                <input list="sku-options-list" name="Form.Lines[@i].SkuId" class="form-control form-control-sm sku-select" value="@ln.SkuId" placeholder="Chọn hoặc nhập mã SKU..." required />
                                            }
                                        </td>
                                        <td>
                                            <input name="Form.Lines[@i].ProductName" class="form-control form-control-sm product-name @(isLocked || isKnownSku ? "bg-light" : "")" value="@ln.ProductName" placeholder="Tên hàng hóa (tự động hoặc nhập mới)..." readonly="@(isLocked || isKnownSku)" required />
                                        </td>
                                        <td>
                                            <input name="Form.Lines[@i].Unit" class="form-control form-control-sm unit @(isLocked || isKnownSku ? "bg-light" : "")" value="@ln.Unit" placeholder="ĐVT" readonly="@(isLocked || isKnownSku)" style="width: 75px;" />
                                        </td>
                                        <td><input name="Form.Lines[@i].DocumentQuantity" type="number" min="0" value="@ln.DocumentQuantity" class="form-control form-control-sm text-end" readonly="@isLocked" /></td>
                                        <td><input name="Form.Lines[@i].Quantity" type="number" min="1" value="@ln.Quantity" class="form-control form-control-sm text-end qty fw-bold text-primary" readonly="@isLocked" required /></td>
                                        <td><input name="Form.Lines[@i].BatchNumber" class="form-control form-control-sm" value="@ln.BatchNumber" placeholder="Lô..." readonly="@isLocked" /></td>
                                        <td><input name="Form.Lines[@i].ExpiryDate" type="date" class="form-control form-control-sm" value="@(ln.ExpiryDate?.ToString("yyyy-MM-dd"))" readonly="@isLocked" /></td>
                                        <td><input name="Form.Lines[@i].UnitPrice" type="number" step="0.01" value="@ln.UnitPrice" class="form-control form-control-sm text-end price" readonly="@isLocked" /></td>
                                        <td class="text-end fw-semibold line-total">@((ln.UnitPrice * ln.Quantity).ToString("N0"))</td>
                                        @if (!isLocked)
                                        {
                                            <td class="text-center no-print">
                                                <button type="button" class="btn btn-sm btn-outline-danger remove-line btn-icon-only"><i class="fa-solid fa-trash-can"></i></button>
                                            </td>
                                        }
                                        <input type="hidden" name="Form.Lines[@i].Id" value="@ln.Id" />
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="9" class="text-end fw-bold text-uppercase text-secondary">Tổng cộng tiền hàng nhập</td>
                                <td class="text-end fw-bold fs-6 text-primary" id="totalAmount">0</td>
                                @if (!isLocked) { <td>&nbsp;</td> }
                            </tr>
                        </tfoot>
                    </table>
                </div>

                @if (!isLocked)
                {
                    <div class="mb-4 no-print">
                        <button type="button" class="btn btn-outline-primary" id="addLine">
                            <i class="fa-solid fa-plus me-1"></i> Thêm hàng hóa
                        </button>
                    </div>
                }

                <!-- Action Button Footer: natural bottom flow -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-4 no-print">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
                    </a>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                            <i class="fa-solid fa-print me-1"></i> In phiếu
                        </button>
                        @if (!isLocked)
                        {
                            <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                                <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Phiếu Nhập Kho
                            </button>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const skus = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(skus));
    const isLockedMode = @(isLocked ? "true" : "false");

    function createRow(idx) {
        const tr = document.createElement('tr');
        tr.className = 'inbound-row';
        tr.innerHTML = `
            <td class="text-center idx">${idx}</td>
            <td>
                <input list="sku-options-list" name="Form.Lines[${idx-1}].SkuId" class="form-control form-control-sm sku-select" placeholder="Chọn hoặc nhập mã SKU..." required />
            </td>
            <td><input name="Form.Lines[${idx-1}].ProductName" class="form-control form-control-sm product-name" placeholder="Tên hàng (tự động hoặc nhập mới)..." required /></td>
            <td><input name="Form.Lines[${idx-1}].Unit" class="form-control form-control-sm unit" value="Cái" placeholder="ĐVT" style="width: 75px;" /></td>
            <td><input name="Form.Lines[${idx-1}].DocumentQuantity" type="number" min="0" value="1" class="form-control form-control-sm text-end" /></td>
            <td><input name="Form.Lines[${idx-1}].Quantity" type="number" min="1" value="1" class="form-control form-control-sm text-end qty fw-bold text-primary" required /></td>
            <td><input name="Form.Lines[${idx-1}].BatchNumber" class="form-control form-control-sm" placeholder="Lô..." /></td>
            <td><input name="Form.Lines[${idx-1}].ExpiryDate" type="date" class="form-control form-control-sm" /></td>
            <td><input name="Form.Lines[${idx-1}].UnitPrice" type="number" step="0.01" value="0" class="form-control form-control-sm text-end price" /></td>
            <td class="text-end fw-semibold line-total">0</td>
            <td class="text-center no-print">
                <button type="button" class="btn btn-sm btn-outline-danger remove-line btn-icon-only"><i class="fa-solid fa-trash-can"></i></button>
            </td>
        `;
        bindRowEvents(tr);
        return tr;
    }

    function bindRowEvents(row) {
        const skuInput = row.querySelector('.sku-select');
        const prodNameInput = row.querySelector('.product-name');
        const unitInput = row.querySelector('.unit');
        const qtyInput = row.querySelector('.qty');
        const priceInput = row.querySelector('.price');
        const removeBtn = row.querySelector('.remove-line');

        function syncSkuState() {
            const val = skuInput?.value?.trim() || '';
            if (!val) return;
            const s = skus.find(x => x.SkuId.toLowerCase() === val.toLowerCase());
            if (s) {
                skuInput.value = s.SkuId;
                if (prodNameInput) {
                    prodNameInput.value = s.ProductName || '';
                    prodNameInput.readOnly = true;
                    prodNameInput.classList.add('bg-light');
                    prodNameInput.title = 'Mã hàng đã có trong danh mục. Tên hàng được điền tự động.';
                }
                if (unitInput) {
                    unitInput.value = s.Unit || 'Cái';
                    unitInput.readOnly = true;
                    unitInput.classList.add('bg-light');
                }
                if (priceInput && (!priceInput.value || parseFloat(priceInput.value) === 0) && s.UnitPrice) {
                    priceInput.value = s.UnitPrice;
                }
            } else {
                // Mã hàng mới: Cho phép người dùng nhập tên hàng hóa mới
                if (prodNameInput) {
                    prodNameInput.readOnly = false;
                    prodNameInput.classList.remove('bg-light');
                    prodNameInput.placeholder = 'Nhập tên hàng mới...';
                    prodNameInput.title = 'Mã hàng mới chưa có trong hệ thống. Vui lòng nhập Tên hàng mới tại đây.';
                    if (!prodNameInput.value || prodNameInput.value === val) {
                        prodNameInput.focus();
                    }
                }
                if (unitInput) {
                    unitInput.readOnly = false;
                    unitInput.classList.remove('bg-light');
                    unitInput.title = 'Nhập đơn vị tính cho hàng mới (Cái, Bộ, Chiếc, Thùng...)';
                }
            }
            recalc();
        }

        skuInput?.addEventListener('change', syncSkuState);
        skuInput?.addEventListener('input', function () {
            const val = this.value.trim();
            const s = skus.find(x => x.SkuId.toLowerCase() === val.toLowerCase());
            if (!s && val.length > 0) {
                if (prodNameInput && prodNameInput.readOnly) {
                    prodNameInput.readOnly = false;
                    prodNameInput.classList.remove('bg-light');
                    prodNameInput.placeholder = 'Nhập tên hàng mới...';
                }
                if (unitInput && unitInput.readOnly) {
                    unitInput.readOnly = false;
                    unitInput.classList.remove('bg-light');
                }
            }
        });

        qtyInput?.addEventListener('input', recalc);
        priceInput?.addEventListener('input', recalc);

        removeBtn?.addEventListener('click', function () {
            row.remove();
            updateIndexes();
            recalc();
        });
    }

    function updateIndexes() {
        const rows = document.querySelectorAll('#linesTableBody tr');
        rows.forEach((r, i) => {
            const idxCell = r.querySelector('.idx');
            if (idxCell) idxCell.innerText = i + 1;
            r.querySelectorAll('input, select').forEach(inp => {
                if (inp.name) {
                    inp.name = inp.name.replace(/Lines\[\d+\]/, `Lines[${i}]`);
                }
            });
        });
    }

    function recalc() {
        let total = 0;
        document.querySelectorAll('#linesTableBody tr').forEach(r => {
            const qty = parseFloat(r.querySelector('.qty')?.value) || 0;
            const price = parseFloat(r.querySelector('.price')?.value) || 0;
            const lt = qty * price;
            const ltCell = r.querySelector('.line-total');
            if (ltCell) ltCell.innerText = lt.toLocaleString();
            total += lt;
        });
        const totalElem = document.getElementById('totalAmount');
        if (totalElem) totalElem.innerText = total.toLocaleString();
    }

    document.addEventListener('DOMContentLoaded', function () {
        if (!isLockedMode) {
            document.querySelectorAll('#linesTableBody tr').forEach(bindRowEvents);

            document.getElementById('addLine')?.addEventListener('click', function () {
                const tbody = document.getElementById('linesTableBody');
                const idx = tbody.children.length + 1;
                const row = createRow(idx);
                tbody.appendChild(row);
                row.querySelector('.sku-select')?.focus();
            });

            if (document.querySelectorAll('#linesTableBody tr').length === 0) {
                document.getElementById('addLine')?.click();
            }
        }

        recalc();
    });
</script>

